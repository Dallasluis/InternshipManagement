{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=InternshipManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Key": "YourSuperSecretKeyHere1234567890!@#$%",
    "Issuer": "InternshipManagementAPI",
    "Audience": "InternshipManagementClient",
    "ExpiryHours": 2
  },
  "Internships": {
    "RequireSubscription": false
  },
  "N8n": {
    "BaseUrl": "http://localhost:5678",
    "UseTestWebhooks": false,
    "TimeoutSeconds": 120
  },
  "Email": {
    "Host": "",
    "Port": 2525,
    "UseSsl": false,
    "SenderName": "Internship Management",
    "SenderAddress": "noreply@internshipmanagement.local",
    "PublicApiBaseUrl": "https://localhost:49161"
  },
  "EmailVerification": {
    "LinkExpiryHours": 24,
    "ResendsPerHour": 3,
    "ResendsPerDay": 10,
    "ReminderAfterDays": 3,
    "DeleteAfterDays": 30,
    "SecurityEventRetentionMonths": 12,
    "PublicApiBaseUrl": "https://localhost:49161"
  },
  "LoginSecurity": {
    "PasswordMinimumLength": 10,
    "PasswordHashIterations": 600000,
    "LockoutMaxFailedAttempts": 5,
    "LockoutWindowMinutes": 15,
    "InitialLockoutMinutes": 15,
    "MaxLockoutMinutes": 60,
    "LoginAttemptsPerIpPerMinute": 20,
    "StudentIdleTimeoutHours": 2,
    "AdminCompanyIdleTimeoutMinutes": 30,
    "AbsoluteSessionHours": 12,
    "RememberStudentDays": 30,
    "SecurityEventRetentionMonths": 12
  },
  "AllowedHosts": "*"
}