        "httpBearerAuth": {
          "id": null,
          "name": "MCP server key"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Returns the student's programme, year of study, skills (with level), education, certifications, jobs and project titles. No name or contact details. Parameters: reason = one short sentence on why you call it; runToken = Pass the runToken from your instructions, copied exactly.",
        "method": "GET",
        "url": "http://host.docker.internal:5003/api/agent-tools/chat/profile-summary",
        "sendQuery": true,
