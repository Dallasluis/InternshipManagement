      "position": [
        -240,
        240
      ]
    },
    {
      "parameters": {
        "toolDescription": "Returns the student's best open internships, ranked by the platform: targetId, title, subtitle (company), matchScore (0 to 100), matchingSkills, matchingQualifications, missingPreferredSkills. Parameters: reason = one short sentence on why you call it; maxResults = how many (1 to 10); runToken = Pass the runToken from your instructions, copied exactly.",
        "method": "GET",
        "url": "http://host.docker.internal:5003/api/agent-tools/chat/my-matches",
        "sendQuery": true,
