        "parametersQuery": {
          "values": [
            {
              "name": "reason",
              "valueProvider": "modelRequired"
            },
            {
              "name": "runToken",
              "valueProvider": "modelRequired"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000002",
