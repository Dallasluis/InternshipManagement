@model InternshipManagement.Web.Models.Admin.AuditLogPage
@{
    ViewData["Title"] = "Audit log";
    var pages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(Model.PageSize, 1)));
    string from = ViewBag.From is DateTime f ? f.ToString("yyyy-MM-dd") : "";
    string to = ViewBag.To is DateTime t ? t.ToString("yyyy-MM-dd") : "";
}

<div class="mb-3">
    <h1 class="h2 mb-1">Audit log</h1>
    <p class="text-muted mb-0">Every change made by an administrator or a company. Entries cannot be edited or deleted.</p>
</div>

@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="actionName" value="@ViewBag.Action" class="form-control" placeholder="Action, e.g. SuspendUser" /></div>
    <div class="col-md-2">
        <select name="role" class="form-select">
            <option value="">Any role</option>
            <option value="Admin" selected="@((ViewBag.Role as string) == "Admin")">Admin</option>
            <option value="Company" selected="@((ViewBag.Role as string) == "Company")">Company</option>
        </select>
    </div>
    <div class="col-md-3"><input name="user" value="@ViewBag.User" class="form-control" placeholder="User email" /></div>
    <div class="col-md-2"><input type="date" name="from" value="@from" class="form-control" aria-label="From date" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@to" class="form-control" aria-label="To date" /></div>
    <div class="col-12"><button class="btn btn-primary btn-sm" type="submit"><i class="fas fa-search me-1"></i> Filter</button>
        <a class="btn btn-link btn-sm" asp-action="Index">Clear</a></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr><th>When (UTC)</th><th>Who</th><th>Action</th><th>Record</th><th>Result</th><th>IP</th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td class="text-nowrap">@e.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(e.UserEmail ?? ("user " + e.UserId))<span class="badge bg-light text-dark border ms-1">@e.Role</span></td>
                    <td><span class="fw-semibold">@e.Action</span><div class="small text-muted">@e.HttpMethod @e.Path</div></td>
                    <td>@(e.EntityId ?? "-")</td>
                    <td><span class="badge @(e.StatusCode < 400 ? "bg-success" : "bg-danger")">@e.StatusCode</span></td>
                    <td class="small text-muted">@e.IpAddress</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No entries match.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <small class="text-muted">@Model.Total entries &middot; page @Model.Page of @pages</small>
        <div class="btn-group btn-group-sm">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                   asp-route-actionName="@ViewBag.Action" asp-route-role="@ViewBag.Role" asp-route-user="@ViewBag.User" asp-route-from="@from" asp-route-to="@to">Previous</a>
            }
            @if (Model.Page < pages)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                   asp-route-actionName="@ViewBag.Action" asp-route-role="@ViewBag.Role" asp-route-user="@ViewBag.User" asp-route-from="@from" asp-route-to="@to">Next</a>
            }
        </div>
    </div>
</div>
