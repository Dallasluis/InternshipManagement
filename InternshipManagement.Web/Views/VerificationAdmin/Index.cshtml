@model InternshipManagement.Web.Controllers.VerificationSlaViewModel
@{ ViewData["Title"] = "Verification turnaround"; }

<div class="container-fluid py-3">
    <h3 class="mb-1">Verification turnaround</h3>
    <p class="text-muted">Target: @(Model.Loaded ? Model.TargetPercentage.ToString("0.#") : "90")% of verification decisions within 3 business days.</p>

    @if (TempData["StatusMessage"] != null) { <div class="alert alert-success">@TempData["StatusMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

    @if (Model.Loaded)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Decisions measured</div>
                    <div class="display-6">@Model.DecisionsMeasured</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Decided within 3 business days</div>
                    <div class="display-6">@Model.DecisionsWithinThreeBusinessDays</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Within target</div>
                    <div class="display-6">@Model.WithinTargetPercentage.ToString("0.#")%</div>
                    <span class="badge @(Model.DecisionsMeasured == 0 ? "bg-secondary" : Model.MeetsTarget ? "bg-success" : "bg-danger")">
                        @(Model.DecisionsMeasured == 0 ? "No decisions yet" : Model.MeetsTarget ? "Target met" : "Below target")
                    </span>
                </div></div>
            </div>
        </div>
    }

    @if (Model.Loaded)
    {
        <div class="card mb-4">
            <div class="card-header bg-white"><h6 class="mb-0">Appeals waiting more than 5 business days</h6></div>
            @if (Model.OverdueAppeals.Count == 0)
            {
                <div class="card-body text-muted">No appeals are overdue.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead><tr><th>Company</th><th>Appeal sent</th><th>Business days waiting</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var appeal in Model.OverdueAppeals)
                            {
                                <tr>
                                    <td>@appeal.CompanyName</td>
                                    <td>@appeal.SubmittedAt.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-danger">@appeal.BusinessDaysWaiting</span></td>
                                    <td><a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="CompanyDetails" asp-route-id="@appeal.CompanyId">Review</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="card-header bg-white"><h6 class="mb-0">Re-verification</h6></div>
        <div class="card-body">
            <p class="mb-3">
                Companies must be re-verified every 24 months, and after 12 months without an active subscription. This check also runs
                automatically every hour; run it now to apply it immediately. Affected companies get a 7-day grace period.
            </p>
            <form asp-action="Reverify" method="post" onsubmit="return confirm('Mark all companies that are due as needing re-verification?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Run re-verification check now</button>
            </form>
        </div>
    </div>
</div>
