@{
    ViewData["Title"] = "Recommended for you";
}
@section Styles { <link rel="stylesheet" href="~/css/student-ai.css" asp-append-version="true" /> }

<div id="ai-root" data-page="matches"
     data-login-url="@Url.Action("Login", "Account")"
     data-job-url="@Url.Action("Job", "StudentAi")"
     data-details-url="@Url.Action("Details", "Internships")"
     data-quick-url="@Url.Action("QuickMatches", "StudentAi")"
     data-start-url="@Url.Action("StartMatches", "StudentAi")">
    @Html.AntiForgeryToken()

    <div class="mb-4">
        <h1 class="h2 mb-1">Recommended for you</h1>
        <p class="text-muted mb-0">Open internships ranked by how well your profile fits what they ask for.</p>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div>
                <label for="match-count" class="form-label small mb-0">Explain the top</label>
                <select id="match-count" class="form-select form-select-sm d-inline-block w-auto ms-1">
                    <option value="3">3</option>
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                </select>
            </div>
            <button id="explain-btn" type="button" class="btn btn-primary">Explain my matches with AI</button>
            <span id="matches-note" class="small text-muted" aria-live="polite"></span>
        </div>
    </div>

    <div id="matches-errors"></div>
    <div id="matches-list"><div class="text-muted py-4 text-center">Loading your matches…</div></div>
</div>

@section Scripts { <script src="~/js/student-ai.js" asp-append-version="true"></script> }
