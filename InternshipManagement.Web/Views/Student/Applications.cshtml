@model List<InternshipManagement.Web.Models.Application.ApplicationResponse>
@{
    ViewData["Title"] = "My Applications";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">My Applications</h1>
        <p class="text-muted">Track all your internship applications in one place</p>
    </div>
    <a asp-controller="Internships" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-search me-1"></i> Find More Internships
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
        <h5>No Applications Yet</h5>
        <p class="text-muted">You haven't applied to any internships yet.</p>
        <a asp-controller="Internships" asp-action="Index" class="btn btn-primary">
            Browse Internships
        </a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Internship</th>
                            <th>Company</th>
                            <th>Applied On</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.OrderByDescending(a => a.AppliedAt))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@app.InternshipId" class="text-decoration-none">
                                        @app.InternshipTitle
                                    </a>
                                </td>
                                <td>@app.CompanyName</td>
                                <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(app.Status)">
                                        @InternshipManagement.Web.Helpers.StatusDisplay.Label(app.Status)
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Student" asp-action="ApplicationDetails" asp-route-id="@app.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (CanWithdraw(app.Status))
                                    {
                                        <form asp-controller="Student" asp-action="WithdrawApplication" method="post" class="d-inline"
                                              onsubmit="return confirm('Withdraw this application? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@app.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Withdraw application" aria-label="Withdraw application">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => InternshipManagement.Web.Helpers.StatusDisplay.Badge(status);

    // Same rule as the API: only applications still in progress can be withdrawn. After an offer is accepted
    // the student withdraws from the placement instead.
    private static bool CanWithdraw(string status) => status is "Applied" or "UnderReview" or "Shortlisted"
        or "InterviewScheduled" or "InterviewCompleted" or "OfferMade";
}
