@model InternshipManagement.Web.Models.Application.ApplicationResponse
@{
    ViewData["Title"] = "Application Details";
}

<div class="mb-3">
    <a asp-controller="Student" asp-action="Applications" class="text-muted">
        <i class="fas fa-arrow-left me-1"></i> Back to My Applications
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.InternshipTitle</h5>
        <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <h6>Company</h6>
                <p>@Model.CompanyName</p>

                <h6>Applied On</h6>
                <p>@Model.AppliedAt.ToString("MMMM dd, yyyy")</p>

                @if (!string.IsNullOrEmpty(Model.CoverLetter))
                {
                    <h6>Cover Letter</h6>
                    <div class="border rounded p-3 bg-light">
                        <p style="white-space: pre-line;">@Model.CoverLetter</p>
                    </div>
                }

                @if (Model.InterviewDateTime.HasValue)
                {
                    <h6>Interview Details</h6>
                    <div class="border rounded p-3 bg-light mb-3">
                        <p class="mb-1"><strong>Date:</strong> @Model.InterviewDateTime.Value.ToString("MMMM dd, yyyy h:mm tt")</p>
                        <p class="mb-1"><strong>Type:</strong> @Model.InterviewType</p>
                        @if (!string.IsNullOrWhiteSpace(Model.InterviewLocationOrLink))
                        {
                            <p class="mb-1"><strong>Location/Link:</strong> <a href="@Model.InterviewLocationOrLink" target="_blank" rel="noopener">@Model.InterviewLocationOrLink</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InterviewNotes))
                        {
                            <p class="mb-0"><strong>Notes:</strong> @Model.InterviewNotes</p>
                        }
                    </div>
                }

                @if (Model.Status == "OfferMade")
                {
                    <h6>Offer</h6>
                    <div class="border rounded p-3 bg-light mb-3">
                        @if (Model.OfferStipendAmount.HasValue)
                        {
                            <p class="mb-1"><strong>Stipend:</strong> @Model.OfferStipendAmount.Value.ToString("C")</p>
                        }
                        @if (Model.OfferStartDate.HasValue)
                        {
                            <p class="mb-1"><strong>Start Date:</strong> @Model.OfferStartDate.Value.ToString("MMMM dd, yyyy")</p>
                        }
                        @if (Model.OfferExpiryDate.HasValue)
                        {
                            <p class="mb-1"><strong>Expiry:</strong> @Model.OfferExpiryDate.Value.ToString("MMMM dd, yyyy")</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OfferDetails))
                        {
                            <p class="mb-0"><strong>Details:</strong> @Model.OfferDetails</p>
                        }
                    </div>

                    <form asp-controller="Student" asp-action="RespondToOffer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" name="accepted" value="true" class="btn btn-success me-2">Accept Offer</button>
                        <button type="submit" name="accepted" value="false" class="btn btn-outline-danger">Decline Offer</button>
                    </form>
                }
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6>Application Status</h6>
                        <p>
                            <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                        </p>
                        <hr />
                        <h6>Timeline</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Applied: @Model.AppliedAt.ToString("MMM dd, yyyy")
                            </li>
                            @if (Model.StatusUpdatedAt.HasValue && Model.StatusUpdatedAt != Model.AppliedAt)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-clock text-warning me-2"></i>
                                    Status Updated: @Model.StatusUpdatedAt.Value.ToString("MMM dd, yyyy")
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "InterviewScheduled" => "bg-primary",
        "InterviewCompleted" => "bg-secondary",
        "OfferMade" => "bg-dark",
        "Accepted" => "bg-success",
        "OfferDeclined" => "bg-danger",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}