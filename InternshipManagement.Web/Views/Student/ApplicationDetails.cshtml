@model InternshipManagement.Web.ViewModels.ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
    var application = Model.Application;
}

<div class="mb-3">
    <a asp-controller="Student" asp-action="Applications" class="text-muted">
        <i class="fas fa-arrow-left me-1"></i> Back to My Applications
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@application.InternshipTitle</h5>
        <span class="badge @GetStatusBadgeClass(application.Status)">@application.Status</span>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <h6>Company</h6>
                <p>@application.CompanyName</p>

                <h6>Applied On</h6>
                <p>@application.AppliedAt.ToString("MMMM dd, yyyy")</p>

                @if (!string.IsNullOrEmpty(application.CoverLetter))
                {
                    <h6>Cover Letter</h6>
                    <div class="border rounded p-3 bg-light">
                        <p style="white-space: pre-line;">@application.CoverLetter</p>
                    </div>
                }

                @if (application.InterviewDateTime.HasValue)
                {
                    <h6>Interview Details</h6>
                    <div class="border rounded p-3 bg-light mb-3">
                        <p class="mb-1"><strong>Date:</strong> @application.InterviewDateTime.Value.ToString("MMMM dd, yyyy h:mm tt")</p>
                        <p class="mb-1"><strong>Type:</strong> @application.InterviewType</p>
                        @if (!string.IsNullOrWhiteSpace(application.InterviewLocationOrLink))
                        {
                            <p class="mb-1"><strong>Location/Link:</strong> <a href="@application.InterviewLocationOrLink" target="_blank" rel="noopener">@application.InterviewLocationOrLink</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(application.InterviewNotes))
                        {
                            <p class="mb-0"><strong>Notes:</strong> @application.InterviewNotes</p>
                        }
                    </div>
                }

                @if (application.Status == "OfferMade")
                {
                    <h6>Offer</h6>
                    <div class="border rounded p-3 bg-light mb-3">
                        @if (application.OfferStipendAmount.HasValue)
                        {
                            <p class="mb-1"><strong>Stipend:</strong> @application.OfferStipendAmount.Value.ToString("C")</p>
                        }
                        @if (application.OfferStartDate.HasValue)
                        {
                            <p class="mb-1"><strong>Start Date:</strong> @application.OfferStartDate.Value.ToString("MMMM dd, yyyy")</p>
                        }
                        @if (application.OfferExpiryDate.HasValue)
                        {
                            <p class="mb-1"><strong>Expiry:</strong> @application.OfferExpiryDate.Value.ToString("MMMM dd, yyyy")</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(application.OfferDetails))
                        {
                            <p class="mb-0"><strong>Details:</strong> @application.OfferDetails</p>
                        }
                    </div>

                    <form asp-controller="Student" asp-action="RespondToOffer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@application.Id" />
                        <button type="submit" name="accepted" value="true" class="btn btn-success me-2">Accept Offer</button>
                        <button type="submit" name="accepted" value="false" class="btn btn-outline-danger">Decline Offer</button>
                    </form>
                }
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6>Application Status</h6>
                        <p>
                            <span class="badge @GetStatusBadgeClass(application.Status)">@application.Status</span>
                        </p>
                        <hr />
                        <h6>Timeline</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Applied: @application.AppliedAt.ToString("MMM dd, yyyy")
                            </li>
                            @if (application.StatusUpdatedAt.HasValue && application.StatusUpdatedAt != application.AppliedAt)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-clock text-warning me-2"></i>
                                    Status Updated: @application.StatusUpdatedAt.Value.ToString("MMM dd, yyyy")
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <hr />
        <h6>Status History</h6>
        @if (!Model.StatusHistory.Any())
        {
            <p class="text-muted mb-0">No status history recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                        {
                            <tr>
                                <td>@item.ChangedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@item.PreviousStatus</td>
                                <td><span class="badge @GetStatusBadgeClass(item.NewStatus)">@item.NewStatus</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "InterviewScheduled" => "bg-primary",
        "InterviewCompleted" => "bg-secondary",
        "OfferMade" => "bg-dark",
        "Accepted" => "bg-success",
        "OfferDeclined" => "bg-danger",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}
