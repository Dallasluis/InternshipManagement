@model InternshipManagement.Web.Models.Internship.PagedInternshipResult
@{
    ViewData["Title"] = "Browse Internships";
    var filters = ViewBag.Filters as InternshipManagement.Web.Models.Internship.InternshipSearchViewModel
                  ?? new InternshipManagement.Web.Models.Internship.InternshipSearchViewModel();
    var industries = Model.Items.Select(item => item.Industry).Where(industry => !string.IsNullOrWhiteSpace(industry)).Distinct(StringComparer.OrdinalIgnoreCase).Take(6).ToList();
    var isStudent = Context.Session.GetString("UserType") == "Student";
}

@functions {
    string SplitWords(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return System.Text.RegularExpressions.Regex.Replace(value, "(?<!^)([A-Z])", " $1");
    }
}

<div class="public-page internships-page">
    <div class="internship-welcome mb-4">
        <div class="internship-welcome-copy">
            <span class="public-eyebrow">YOUR NEXT OPPORTUNITY</span>
            <h1>Find work that moves you forward</h1>
            <p>Explore placements where you can learn, contribute, and grow.</p>
        </div>
        @if (isStudent)
        {
            <a asp-controller="StudentAi" asp-action="Matches" class="internship-recommend-link">
                <span><i class="fas fa-bullseye" aria-hidden="true"></i></span><span><strong>See your matches</strong><small>Opportunities picked for you</small></span><i class="fas fa-arrow-right ms-auto" aria-hidden="true"></i>
            </a>
        }
    </div>

    <form method="get" asp-action="Index" class="internship-filter-panel mb-4">
        <input type="hidden" name="SortBy" value="@filters.SortBy" />
        <div class="internship-filter-title"><span class="internship-filter-icon"><i class="fas fa-sliders" aria-hidden="true"></i></span><div><strong>Discover your next step</strong><small>Search and refine the opportunities</small></div></div>
        <div class="internship-filters">
            <label class="internship-filter-field"><span class="visually-hidden">Title or keyword</span><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" name="Keyword" value="@filters.Keyword" class="form-control" placeholder="Role, skill, or company" /></label>
            <label class="internship-filter-field"><span class="visually-hidden">Location</span><i class="fas fa-location-dot" aria-hidden="true"></i><input type="text" name="Location" value="@filters.Location" class="form-control" placeholder="Location" data-location-picker data-location-mode="city" data-location-popover /></label>
            <label class="internship-filter-field"><span class="visually-hidden">Industry</span><i class="fas fa-layer-group" aria-hidden="true"></i><input type="text" name="Industry" value="@filters.Industry" class="form-control" placeholder="Industry" data-categories /></label>
            <label class="internship-filter-field"><span class="visually-hidden">Work arrangement</span><i class="fas fa-laptop-house" aria-hidden="true"></i><select name="WorkArrangement" class="form-select"><option value="">Any work style</option>@foreach (var arrangement in new[] { "OnSite", "Remote", "Hybrid" }) { <option value="@arrangement" selected="@(filters.WorkArrangement == arrangement)">@SplitWords(arrangement)</option> }</select></label>
            <button type="submit" class="btn btn-primary internship-search-button">Search opportunities <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></button>
        </div>
        <div class="internship-quick-filters">
            <span>Quick filters</span>
            <label class="internship-filter-pill"><input type="checkbox" name="IsRemote" value="true" checked="@(filters.IsRemote == true)" /><i class="fas fa-wifi" aria-hidden="true"></i> Remote</label>
            <label class="internship-filter-pill"><input type="checkbox" name="MinStipend" value="1" checked="@(filters.MinStipend.HasValue)" /><i class="fas fa-coins" aria-hidden="true"></i> Paid opportunities</label>
            @if (!string.IsNullOrWhiteSpace(filters.Keyword) || !string.IsNullOrWhiteSpace(filters.Location) || !string.IsNullOrWhiteSpace(filters.Industry) || !string.IsNullOrWhiteSpace(filters.WorkArrangement) || filters.IsRemote.HasValue || filters.MinStipend.HasValue)
            {
                <a asp-action="Index" class="internship-clear-filters">Clear filters</a>
            }
        </div>
    </form>

    @if (industries.Count > 1)
    {
        <div class="internship-industry-shortcuts"><span>Explore by industry</span>@foreach (var industry in industries) { <a asp-action="Index" asp-route-Industry="@industry">@industry</a> }</div>
    }

    <div class="internship-results-bar">
        <div><h2>Explore opportunities</h2><span><strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "opportunity" : "opportunities") found</span></div>
        <form method="get" asp-action="Index" class="internship-sort-form">
            <input type="hidden" name="Keyword" value="@filters.Keyword" /><input type="hidden" name="Location" value="@filters.Location" /><input type="hidden" name="Industry" value="@filters.Industry" /><input type="hidden" name="WorkArrangement" value="@filters.WorkArrangement" /><input type="hidden" name="MinStipend" value="@filters.MinStipend" /><input type="hidden" name="IsRemote" value="@filters.IsRemote" />
            <label for="internship-sort">Sort by</label>
            <select id="internship-sort" name="SortBy" class="form-select form-select-sm"><option value="relevance" selected="@(filters.SortBy == "relevance" || string.IsNullOrWhiteSpace(filters.SortBy))">Best match</option><option value="newest" selected="@(filters.SortBy == "newest")">Newest</option><option value="oldest" selected="@(filters.SortBy == "oldest")">Oldest</option><option value="popular" selected="@(filters.SortBy == "popular")">Most viewed</option></select>
            <button type="submit" class="btn btn-outline-primary btn-sm">Sort</button>
        </form>
    </div>

@if (!Model.Items.Any())
{
    <div class="internship-empty-state"><span><i class="fas fa-binoculars" aria-hidden="true"></i></span><h2>No matching opportunities yet</h2><p>Try a different keyword or broaden your filters to see more placements.</p><a asp-action="Index" class="btn btn-outline-primary">Browse all opportunities</a></div>
}
else
{
    <div class="row g-4">
        @foreach (var internship in Model.Items)
        {
            var daysLeft = (internship.ApplicationDeadline.Date - DateTime.Today).Days;
            var isClosingSoon = daysLeft >= 0 && daysLeft <= 7;
            var isNew = internship.PublishedAt.HasValue && (DateTime.UtcNow - internship.PublishedAt.Value).TotalDays is >= 0 and <= 14;
            <div class="col-12 col-xl-6">
                <article class="internship-card h-100">
                    <div class="internship-logo-rail">
                        <div class="internship-company-mark">
                            @if (!string.IsNullOrWhiteSpace(internship.CompanyLogoUrl)) { <img src="@internship.CompanyLogoUrl" alt="" /> }
                            else { <span>@(string.IsNullOrWhiteSpace(internship.CompanyName) ? "I" : internship.CompanyName[..1].ToUpperInvariant())</span> }
                        </div>
                    </div>
                    <div class="internship-card-main">
                    <div class="internship-card-top">
                        <div class="internship-company-copy"><strong>@internship.CompanyName</strong><small>Company</small></div>
                        @if (isStudent)
                        {
                            <button type="button" class="internship-save-button js-internship-save @(internship.IsSaved ? "is-saved" : "")" aria-label="@(internship.IsSaved ? "Remove saved internship" : "Save internship for later")" title="@(internship.IsSaved ? "Remove saved internship" : "Save for later")" aria-pressed="@(internship.IsSaved ? "true" : "false")" data-saved="@(internship.IsSaved ? "true" : "false")" data-add-url="@Url.Action("Add", "SavedInternships", new { id = internship.Id })" data-remove-url="@Url.Action("Remove", "SavedInternships", new { id = internship.Id })"><i class="@(internship.IsSaved ? "fas" : "far") fa-bookmark" aria-hidden="true"></i></button>
                        }
                    </div>
                    <div class="internship-card-content">
                        <div class="internship-card-badges">
                            @if (isNew) { <span class="internship-new-badge"><i class="fas fa-sparkles me-1" aria-hidden="true"></i>New</span> }
                            @if (internship.MatchScore > 0 && Context.Session.GetString("UserType") == "Student") { <span class="internship-match-badge"><i class="fas fa-bullseye me-1" aria-hidden="true"></i>@internship.MatchScore% match</span> }
                            @if (isClosingSoon) { <span class="internship-deadline-badge">Closing soon</span> }
                            @if (internship.HasApplied) { <span class="internship-applied-badge"><i class="fas fa-check me-1" aria-hidden="true"></i>Applied</span> }
                        </div>
                        <h2><a asp-action="Details" asp-route-id="@internship.Id">@internship.Title</a></h2>
                        <div class="internship-meta">
                            @if (internship.WorkArrangement == "OnSite" && !string.IsNullOrWhiteSpace(internship.Location)) { <span><i class="fas fa-location-dot" aria-hidden="true"></i>@internship.Location</span> }
                            @if (!string.IsNullOrWhiteSpace(internship.Industry)) { <span><i class="fas fa-briefcase" aria-hidden="true"></i>@internship.Industry</span> }
                            <span><i class="fas fa-laptop-house" aria-hidden="true"></i>@SplitWords(internship.WorkArrangement)</span>
                            @if (!string.IsNullOrWhiteSpace(internship.Duration)) { <span><i class="far fa-clock" aria-hidden="true"></i>@SplitWords(internship.Duration)</span> }
                            @if (internship.StipendAmount.HasValue) { <span class="internship-paid-chip"><i class="fas fa-circle-dollar-to-slot" aria-hidden="true"></i>Paid</span> }
                        </div>
                        <p class="internship-description">@internship.Description</p>
                        <div class="internship-card-footer">
                            <div><small>Apply by</small><strong>@internship.ApplicationDeadline.ToString("MMM d, yyyy")</strong></div>
                            @if (internship.StipendAmount.HasValue) { <div class="internship-pay"><small>Stipend</small><strong>@internship.Currency @internship.StipendAmount.Value.ToString("N0")</strong></div> }
                        </div>
                    </div>
                    <a asp-action="Details" asp-route-id="@internship.Id" class="internship-card-action">View opportunity <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Keyword="@filters.Keyword"
                           asp-route-Location="@filters.Location"
                           asp-route-Industry="@filters.Industry"
                           asp-route-WorkArrangement="@filters.WorkArrangement"
                           asp-route-InternshipType="@filters.InternshipType"
                           asp-route-MinStipend="@filters.MinStipend"
                           asp-route-IsRemote="@filters.IsRemote"
                           asp-route-SortBy="@filters.SortBy"
                           asp-route-PageNumber="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@if (isStudent)
{
    <div class="visually-hidden" role="status" aria-live="polite" id="internship-save-status"></div>
}

@section Scripts {
    @if (isStudent)
    {
        <script>
            document.querySelectorAll('.js-internship-save').forEach(function (button) {
                button.addEventListener('click', function () {
                    var saved = button.dataset.saved === 'true';
                    var status = document.getElementById('internship-save-status');
                    button.disabled = true;
                    fetch(saved ? button.dataset.removeUrl : button.dataset.addUrl, { method: 'POST', credentials: 'same-origin' })
                        .then(function (response) { return response.json().catch(function () { return {}; }).then(function (body) { return { ok: response.ok, body: body }; }); })
                        .then(function (result) {
                            if (!result.ok) throw new Error(result.body.message || 'Could not update your saved internships.');
                            button.dataset.saved = saved ? 'false' : 'true';
                            button.setAttribute('aria-pressed', saved ? 'false' : 'true');
                            button.setAttribute('aria-label', saved ? 'Save internship for later' : 'Remove saved internship');
                            button.classList.toggle('is-saved', !saved);
                            button.querySelector('i').className = (saved ? 'far' : 'fas') + ' fa-bookmark';
                            button.querySelector('span').textContent = saved ? 'Save for later' : 'Saved';
                            if (status) status.textContent = saved ? 'Internship removed from saved list.' : 'Internship saved for later.';
                        })
                        .catch(function (error) { if (status) status.textContent = error.message || 'Could not update your saved internships.'; })
                        .finally(function () { button.disabled = false; });
                });
            });
        </script>
    }
}
