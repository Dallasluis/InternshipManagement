@{
    var userFullName = Context.Session.GetString("UserFullName");
    var userType = Context.Session.GetString("UserType");
}

@if (!string.IsNullOrEmpty(userFullName))
{
    <aside class="col-md-3 col-lg-2 d-md-block sidebar collapse" id="workspace-sidebar">
        <div class="sidebar-inner">
            <a class="workspace-brand" asp-controller="Home" asp-action="Index" aria-label="Interlane Internships home"><img src="~/images/interlane-logo.png" alt="Interlane Internships" /></a>
            <div class="sidebar-profile">
                <div class="avatar-circle me-2">@userFullName.FirstOrDefault()</div>
                <div class="sidebar-profile-copy">
                    <div class="fw-bold">@userFullName</div>
                    <small>@userType workspace</small>
                </div>
            </div>
            <div class="sidebar-caption">WORKSPACE</div>
            @if (userType == "Student")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Student" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Profile">
                            <i class="fas fa-user me-2"></i> My Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ProfileSections" asp-action="Index">
                            <i class="fas fa-graduation-cap me-2"></i> Education &amp; Skills
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Internships" asp-action="Index">
                            <i class="fas fa-search me-2"></i> Browse Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SavedInternships" asp-action="Index">
                            <i class="fas fa-bookmark me-2"></i> Saved Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="StudentAi" asp-action="Matches">
                            <i class="fas fa-bullseye me-2"></i> Recommended for me
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="StudentAi" asp-action="CvAnalysis">
                            <i class="fas fa-file-pdf me-2"></i> CV Analysis
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="StudentAi" asp-action="SkillGaps">
                            <i class="fas fa-chart-line me-2"></i> Skill Gaps
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Applications">
                            <i class="fas fa-file-alt me-2"></i> My Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Placements">
                            <i class="fas fa-id-badge me-2"></i> My Placements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
                <div class="sidebar-group-label">CAREER TOOLS</div>
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Index"><i class="fas fa-compass"></i><span>Career resources</span></a></li>
                </ul>
            }
            else if (userType == "Company")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Company" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Profile">
                            <i class="fas fa-building me-2"></i> Company Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="VerificationHistory" asp-action="Index">
                            <i class="fas fa-clipboard-check me-2"></i> Verification History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="CreateInternship">
                            <i class="fas fa-plus me-2"></i> Post Internship
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="ManageInternships">
                            <i class="fas fa-briefcase me-2"></i> My Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Applications">
                            <i class="fas fa-users me-2"></i> Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Placements">
                            <i class="fas fa-id-badge me-2"></i> Placements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
            }
            else if (userType == "Admin")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Users">
                            <i class="fas fa-user-graduate me-2"></i> Students
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Companies">
                            <i class="fas fa-building me-2"></i> Companies
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Internships">
                            <i class="fas fa-briefcase me-2"></i> Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                            <i class="fas fa-flag me-2"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Companies">
                            <i class="fas fa-user-check me-2"></i> Company Verification
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="VerificationAdmin" asp-action="Index">
                            <i class="fas fa-stopwatch me-2"></i> Verification Turnaround
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AdminWithdrawals" asp-action="Index">
                            <i class="fas fa-gavel me-2"></i> Withdrawal Disputes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AdminAudit" asp-action="Index">
                            <i class="fas fa-clipboard-list me-2"></i> Audit Log
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Categories" asp-action="Index">
                            <i class="fas fa-tags me-2"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
            }
            <div class="sidebar-bottom">
            <div class="px-3 mt-3">
                <a class="btn btn-sm btn-outline-secondary w-100" asp-controller="MyData" asp-action="Download">
                    <i class="fas fa-download me-2"></i> Download my data
                </a>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 mt-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                </button>
            </form>
            </div>
        </div>
    </aside>
}

<script>
    // Highlight the menu item for the page you are on.
    (function () {
        var links = document.querySelectorAll('.sidebar .nav-link[href]');
        var path = location.pathname.replace(/\/+$/, '').toLowerCase() || '/';
        var alias = { applicationdetails: 'applications', placementdetails: 'placements', applicationreview: 'applications',
                      companydetails: 'companies', editinternship: 'manageinternships', details: 'index' };
        function norm(h) { try { return new URL(h, location.origin).pathname.replace(/\/+$/, '').toLowerCase(); } catch (e) { return ''; } }
        var best = null, bestLen = -1;
        links.forEach(function (a) {
            a.classList.remove('active'); a.removeAttribute('aria-current');
            var h = norm(a.getAttribute('href'));
            if (!h) return;
            var match = path === h || path.indexOf(h + '/') === 0;
            if (!match) {
                var parts = path.split('/').filter(Boolean);
                if (parts.length >= 2 && alias[parts[1]]) match = h === '/' + parts[0] + '/' + alias[parts[1]];
            }
            if (match && h.length > bestLen) { best = a; bestLen = h.length; }
        });
        if (best) { best.classList.add('active'); best.setAttribute('aria-current', 'page'); }
    })();
</script>
