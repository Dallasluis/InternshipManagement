@{
    var userFullName = Context.Session.GetString("UserFullName");
    var userType = Context.Session.GetString("UserType");
}

@if (!string.IsNullOrEmpty(userFullName))
{
    <aside class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse" style="min-height: 100vh;">
        <div class="position-sticky pt-3">
            <div class="d-flex align-items-center mb-4 px-3">
                <div class="avatar-circle me-2">@userFullName.FirstOrDefault()</div>
                <div>
                    <div class="fw-bold">@userFullName</div>
                    <small class="text-muted">@userType</small>
                </div>
            </div>
            <hr />
            @if (userType == "Student")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Student" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Profile">
                            <i class="fas fa-user me-2"></i> My Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Internships" asp-action="Index">
                            <i class="fas fa-search me-2"></i> Browse Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Applications">
                            <i class="fas fa-file-alt me-2"></i> My Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
            }
            else if (userType == "Company")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Company" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Profile">
                            <i class="fas fa-building me-2"></i> Company Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="CreateInternship">
                            <i class="fas fa-plus me-2"></i> Post Internship
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="ManageInternships">
                            <i class="fas fa-briefcase me-2"></i> My Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Applications">
                            <i class="fas fa-users me-2"></i> Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
            }
            else if (userType == "Admin")
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="fas fa-chart-pie me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Users">
                            <i class="fas fa-user-graduate me-2"></i> Students
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Companies">
                            <i class="fas fa-building me-2"></i> Companies
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Internships">
                            <i class="fas fa-briefcase me-2"></i> Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                            <i class="fas fa-file-alt me-2"></i> Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Companies">
                            <i class="fas fa-user-check me-2"></i> Company Verification
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Settings">
                            <i class="fas fa-cog me-2"></i> Settings
                        </a>
                    </li>
                </ul>
            }
            <hr />
            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 mt-4">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                </button>
            </form>
        </div>
    </aside>
}