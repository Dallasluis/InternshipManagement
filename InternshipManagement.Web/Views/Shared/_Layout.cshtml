@{
    var isAuthenticated = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
    var embed = isAuthenticated && Context.Request.Query["embed"] == "1";   // page shown inside the assistant panel
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternshipHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (embed)
    {
        <main class="p-3">@RenderBody()</main>
    }
    else
    {
    <div id="app-global-loader" class="app-global-loader d-none" role="status" aria-live="polite" aria-busy="true">
        <div class="app-global-loader-inner">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading...</span>
        </div>
    </div>
    <div id="app-toast-container" class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite" aria-atomic="true"></div>
    <div class="d-flex flex-column min-vh-100">
        @if (!isAuthenticated)
        {
            <partial name="_Navbar" />
        }
        <div class="container-fluid flex-grow-1">
            <div class="row">
                @if (isAuthenticated)
                {
                    <partial name="_Sidebar" />
                    <main class="col-md-9 col-lg-10 px-4 py-3 app-main">
                        <div class="app-topbar">
                            <div class="d-flex align-items-center gap-2">
                                <button class="mobile-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#workspace-sidebar" aria-controls="workspace-sidebar" aria-expanded="false" aria-label="Open navigation"><i class="fas fa-bars"></i></button>
                                <div class="app-topbar-context"><span class="app-topbar-dot"></span>@(Context.Session.GetString("UserType") ?? "Workspace") workspace</div>
                            </div>
                            <div class="app-topbar-actions"><partial name="_NotificationBell" /><span class="app-topbar-user" title="@(Context.Session.GetString("UserFullName"))">@(Context.Session.GetString("UserFullName")?.FirstOrDefault())</span></div>
                        </div>
                        <partial name="_VerifyEmailBanner" />
                        @RenderBody()
                    </main>
                }
                else
                {
                    <main class="col-12 px-4 py-3">
                        @RenderBody()
                    </main>
                }
            </div>
        </div>
        @if (!isAuthenticated)
        {
            <partial name="_Footer" />
        }
    </div>
    <partial name="_AssistantWidget" />
    <partial name="_CompanyAssistantWidget" />
    }
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
