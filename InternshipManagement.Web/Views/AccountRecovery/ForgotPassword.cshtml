@model InternshipManagement.Web.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fas fa-key fa-3x text-primary mb-3"></i>
            <h2 class="auth-title">Forgot your password?</h2>
            <p class="auth-subtitle">Enter your email and we will send you a link to choose a new one.</p>
        </div>

        <form asp-controller="AccountRecovery" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Account" asp-action="Login" class="small">Back to sign in</a>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
