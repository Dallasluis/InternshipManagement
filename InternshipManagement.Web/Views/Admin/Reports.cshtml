@model List<InternshipManagement.Web.Models.Admin.ReportListResponse>
@{
    ViewData["Title"] = "Manage Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Reports</h1>
        <p class="text-muted">Review and resolve fraud and content reports</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Internship</th>
                        <th>Reported By</th>
                        <th>Status</th>
                        <th>Reported</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var report in Model.OrderByDescending(r => r.CreatedAt))
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-warning">@report.Type</span>
                                </td>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@report.Id" class="text-decoration-none">
                                        @report.InternshipTitle
                                    </a>
                                </td>
                                <td>@report.ReporterName</td>
                                <td>
                                    <span class="badge @GetReportBadgeClass(report.Status)">
                                        @InternshipManagement.Web.Helpers.StatusDisplay.Label(report.Status)
                                    </span>
                                </td>
                                <td>@report.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (report.Status == "Pending" || report.Status == "UnderInvestigation")
                                    {
                                        <button class="btn btn-sm btn-info" onclick="resolveReport(@report.Id, 'UnderInvestigation', '@report.Type')">
                                            <i class="fas fa-search"></i> Investigate
                                        </button>
                                        <button class="btn btn-sm btn-success" onclick="resolveReport(@report.Id, 'Resolved', '@report.Type')">
                                            <i class="fas fa-check"></i> Resolve
                                        </button>
                                        <button class="btn btn-sm btn-danger" onclick="resolveReport(@report.Id, 'Dismissed', '@report.Type')">
                                            <i class="fas fa-times"></i> Dismiss
                                        </button>
                                    }
                                    @if (report.Status == "Resolved" || report.Status == "Dismissed")
                                    {
                                        <span class="text-muted">Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No reports submitted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string GetReportBadgeClass(string status) => InternshipManagement.Web.Helpers.StatusDisplay.Badge(status);
}

@section Scripts {
    <script>
        function resolveReport(id, status, reportType) {
            const response = prompt('Add an audit note for this report decision:');
            if (!response) return;
            const fraudUpheld = (reportType === 'Fraud' || reportType === 'Scam')
                && status === 'Resolved'
                && confirm('Was the fraud/scam allegation upheld?');
            const resolved = status === 'Resolved' || status === 'Dismissed';
            const query = new URLSearchParams({
                id: id,
                resolved: resolved,
                status: status,
                fraudUpheld: fraudUpheld,
                response: response
            });
            if (confirm(`Are you sure you want to mark this report ${status}?`)) {
                fetch(`/Admin/ResolveReport?${query}`, { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Failed to resolve report.');
                        }
                    })
                    .catch(error => {
                        alert('Failed to resolve report.');
                    });
            }
        }
    </script>
}