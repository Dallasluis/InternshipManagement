@model InternshipManagement.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
@section Styles { <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /> }

<div class="dash">
    <section class="role-welcome admin-welcome dash-in">
        <div class="role-welcome-copy">
            <div class="dash-date" id="dash-date"></div>
            <h1><span id="dash-greeting">Welcome back</span>, Admin</h1>
            <p>Platform overview and what needs your attention.</p>
            <a asp-controller="VerificationAdmin" asp-action="Index" class="btn btn-light"><i class="fas fa-shield-alt me-2"></i>Review verifications <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
        <div class="role-welcome-art" aria-hidden="true"><i class="fas fa-chart-pie"></i><i class="fas fa-shield-alt"></i><span></span></div>
        <div class="role-welcome-link"><a asp-controller="VerificationAdmin" asp-action="Index"><i class="fas fa-stopwatch me-1"></i>Verification SLA</a><button type="button" onclick="location.reload()"><i class="fas fa-sync-alt me-1"></i>Refresh</button></div>
    </section>

    @if (Model.Stats == null)
    {
        <div class="alert alert-warning">Unable to load statistics.</div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mt-1 mb-2 dash-in"><div><div class="text-uppercase small fw-bold text-success" style="letter-spacing:.09em">Needs attention</div><div class="small text-muted">Review pending work to keep the platform moving.</div></div></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6 dash-in">
                <a class="dash-tile @(Model.Stats.PendingVerifications > 0 ? "alert-tile" : "")" style="--tile:#dc2626" asp-controller="Admin" asp-action="Companies">
                    <span class="ico"><i class="fas fa-user-shield"></i></span>
                    <span><div class="num" data-count="@Model.Stats.PendingVerifications">@Model.Stats.PendingVerifications</div><div class="lbl">Companies awaiting verification</div><div class="sub">@(Model.Stats.PendingVerifications == 0 ? "All caught up" : "Review these first")</div></span>
                    <span class="ms-auto text-muted"><i class="fas fa-chevron-right"></i></span>
                </a>
            </div>
            <div class="col-md-6 dash-in">
                <a class="dash-tile @(Model.Stats.PendingReports > 0 ? "alert-tile" : "")" style="--tile:#d97706" asp-controller="Admin" asp-action="Reports">
                    <span class="ico"><i class="fas fa-flag"></i></span>
                    <span><div class="num" data-count="@Model.Stats.PendingReports">@Model.Stats.PendingReports</div><div class="lbl">Reports to review</div><div class="sub">@(Model.Stats.PendingReports == 0 ? "Nothing reported" : "Reported internships")</div></span>
                    <span class="ms-auto text-muted"><i class="fas fa-chevron-right"></i></span>
                </a>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between mt-4 mb-2 dash-in"><div><div class="text-uppercase small fw-bold text-success" style="letter-spacing:.09em">Platform overview</div><div class="small text-muted">A snapshot of activity across InternshipHub.</div></div></div>
        <div class="row g-3 mb-3">
            <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#2563eb" asp-controller="Admin" asp-action="Users"><span class="ico"><i class="fas fa-users"></i></span><span><div class="num" data-count="@Model.Stats.TotalUsers">@Model.Stats.TotalUsers</div><div class="lbl">Users</div><div class="sub">@Model.Stats.TotalStudents students · @Model.Stats.TotalCompanies companies</div></span></a></div>
            <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#059669" asp-controller="Admin" asp-action="Internships"><span class="ico"><i class="fas fa-briefcase"></i></span><span><div class="num" data-count="@Model.Stats.TotalInternships">@Model.Stats.TotalInternships</div><div class="lbl">Internships</div><div class="sub">@Model.Stats.ActiveInternships published</div></span></a></div>
            <div class="col-md-3 col-6 dash-in"><div class="dash-tile" style="--tile:#7c3aed"><span class="ico"><i class="fas fa-paper-plane"></i></span><span><div class="num" data-count="@Model.Stats.TotalApplications">@Model.Stats.TotalApplications</div><div class="lbl">Applications</div><div class="sub">@Model.Stats.PendingReviews pending review</div></span></div></div>
            <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#0891b2" asp-controller="Admin" asp-action="Companies"><span class="ico"><i class="fas fa-building"></i></span><span><div class="num" data-count="@Model.Stats.TotalCompanies">@Model.Stats.TotalCompanies</div><div class="lbl">Companies</div></span></a></div>
        </div>

        @if (Model.Stats.MonthlyTrend?.Any() == true)
        {
            var maxActivity = Math.Max(1, Model.Stats.MonthlyTrend.Max(x => Math.Max(x.Applications, x.Users)));
            <div class="dash-card admin-analytics dash-in mb-3">
                <div class="head"><h2><i class="fas fa-chart-column me-2 text-success"></i>Platform activity</h2><span class="small text-muted">Recent monthly trends</span></div>
                <div class="body">
                    <div class="admin-chart" role="img" aria-label="Monthly users and applications activity">
                        @foreach (var month in Model.Stats.MonthlyTrend)
                        {
                            var usersHeight = Math.Max(4, month.Users * 100 / maxActivity);
                            var appsHeight = Math.Max(4, month.Applications * 100 / maxActivity);
                            <div class="admin-chart-month" title="@month.Month: @month.Users users, @month.Applications applications">
                                <div class="admin-chart-bars"><span class="users-bar" style="height:@(usersHeight)%"></span><span class="apps-bar" style="height:@(appsHeight)%"></span></div>
                                <small>@month.Month</small>
                            </div>
                        }
                    </div>
                    <div class="admin-chart-legend"><span><i class="users-bar"></i>Users</span><span><i class="apps-bar"></i>Applications</span></div>
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-6 dash-in">
                <div class="dash-card">
                    <div class="head"><h2><i class="fas fa-building me-2 text-success"></i>Recent companies</h2><a asp-controller="Admin" asp-action="Companies" class="small">View all <i class="fas fa-arrow-right ms-1"></i></a></div>
                    @if (Model.RecentCompanies.Any())
                    {
                        <div class="table-responsive"><table class="table table-hover">
                            <thead><tr><th>Company</th><th>Industry</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var company in Model.RecentCompanies)
                            {
                                <tr><td class="fw-semibold">@company.CompanyName</td><td class="text-muted">@company.Industry</td>
                                    <td><span class="badge @InternshipManagement.Web.Helpers.StatusDisplay.VerificationBadge(company.VerificationStatus)">@InternshipManagement.Web.Helpers.StatusDisplay.VerificationLabel(company.VerificationStatus)</span></td></tr>
                            }
                            </tbody></table></div>
                    }
                    else { <div class="dash-empty"><div class="big"><i class="fas fa-building"></i></div>No companies registered yet.</div> }
                </div>
            </div>
            <div class="col-lg-6 dash-in">
                <div class="dash-card">
                    <div class="head"><h2><i class="fas fa-flag me-2 text-success"></i>Recent reports</h2><a asp-controller="Admin" asp-action="Reports" class="small">View all <i class="fas fa-arrow-right ms-1"></i></a></div>
                    @if (Model.RecentReports.Any())
                    {
                        <div class="table-responsive"><table class="table table-hover">
                            <thead><tr><th>Type</th><th>Internship</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var report in Model.RecentReports)
                            {
                                <tr><td><span class="badge text-bg-warning">@report.Type</span></td><td>@report.InternshipTitle</td>
                                    <td><span class="badge @InternshipManagement.Web.Helpers.StatusDisplay.Badge(report.Status)">@InternshipManagement.Web.Helpers.StatusDisplay.Label(report.Status)</span></td></tr>
                            }
                            </tbody></table></div>
                    }
                    else { <div class="dash-empty"><div class="big"><i class="fas fa-flag"></i></div>No reports submitted yet.</div> }
                </div>
            </div>
        </div>
    }
</div>

@functions {
    private string GetVerificationBadgeClass(string status) => status switch
    {
        "Verified" => "bg-success", "Pending" => "bg-warning text-dark", "UnderReview" => "bg-info text-dark",
        "Rejected" => "bg-danger", _ => "bg-secondary"
    };

    private string GetReportBadgeClass(string status) => status switch
    {
        "Resolved" => "bg-success", "Pending" => "bg-warning text-dark", "UnderInvestigation" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

@section Scripts { <script src="~/js/dashboard.js" asp-append-version="true"></script> }
