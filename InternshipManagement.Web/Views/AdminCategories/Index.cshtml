@model List<InternshipManagement.Web.Models.Admin.CategoryItem>
@{
    ViewData["Title"] = "Internship categories";
}

<div class="mb-3">
    <h1 class="h2 mb-1">Internship categories</h1>
    <p class="text-muted mb-0">Companies and students get these as suggestions for the industry field. Hiding or removing one never changes internships that already use it.</p>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-controller="Categories" asp-action="Add" method="post" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Add a category</label>
                <input name="name" class="form-control" maxlength="100" minlength="2" required placeholder="e.g. Veterinary Science" />
            </div>
            <div class="col-md-4"><button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i> Add</button></div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Shown</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><input form="f-@c.Id" name="name" value="@c.Name" class="form-control form-control-sm" style="max-width:280px" maxlength="100" minlength="2" required /></td>
                    <td>
                        <div class="form-check form-switch">
                            <input form="f-@c.Id" class="form-check-input" type="checkbox" name="isActive" value="true" @(c.IsActive ? "checked" : "") aria-label="Shown in suggestions" />
                            <input form="f-@c.Id" type="hidden" name="isActive" value="false" />
                        </div>
                    </td>
                    <td class="text-end text-nowrap">
                        <form id="f-@c.Id" asp-controller="Categories" asp-action="Update" asp-route-id="@c.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                        </form>
                        <form asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Remove this category? Internships keep their text.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-4">No categories yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
