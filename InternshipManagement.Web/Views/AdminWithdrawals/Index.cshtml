@model List<InternshipManagement.Web.Models.Admin.DisputedWithdrawalItem>
@{
    ViewData["Title"] = "Withdrawal disputes";
}

<div class="mb-3">
    <h1 class="h2 mb-1">Withdrawal disputes</h1>
    <p class="text-muted mb-0">An intern asked to leave, the company said no, and the intern disputed it. Decide each one below.</p>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

@if (Model.Count == 0 && ViewBag.Error == null)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="fas fa-check-circle fa-2x mb-2"></i>
        <div>No disputes are waiting for a decision.</div>
    </div></div>
}

@foreach (var item in Model)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between gap-2">
            <div>
                <strong>@item.StudentName</strong> at <strong>@item.CompanyName</strong>
                <div class="text-muted small">@item.InternshipTitle &middot; placement is @item.PlacementStatus</div>
            </div>
            <div class="text-muted small text-end">
                Asked @item.RequestedAt.ToString("d MMM yyyy")
                @if (item.DisputedAt.HasValue)
                {
                    <text><br />Disputed @item.DisputedAt.Value.ToString("d MMM yyyy")</text>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="small text-muted">Why the intern wants to leave</div>
                    <div class="text-break">@item.StudentReason</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">Why the company said no</div>
                    <div class="text-break">@(string.IsNullOrWhiteSpace(item.CompanyDecisionNotes) ? "No reason given." : item.CompanyDecisionNotes)</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">Why the intern disputes it</div>
                    <div class="text-break">@item.DisputeReason</div>
                </div>
            </div>

            <form asp-controller="AdminWithdrawals" asp-action="Resolve" asp-route-id="@item.Id" method="post" class="mt-3"
                  onsubmit="return confirm('Save this decision? Both sides will be told, and it cannot be undone.');">
                <label class="form-label">Note for both sides (optional)</label>
                <textarea name="notes" class="form-control" rows="2" maxlength="1000"></textarea>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="submit" name="decision" value="approve" class="btn btn-success">
                        <i class="fas fa-door-open me-1"></i> Approve withdrawal (end placement)
                    </button>
                    <button type="submit" name="decision" value="reject" class="btn btn-outline-secondary">
                        <i class="fas fa-ban me-1"></i> Keep company's decision
                    </button>
                </div>
            </form>
        </div>
    </div>
}
