@{
    ViewData["Title"] = "About Us";
}

<section class="about-hero">
    <img src="~/images/landing-teamwork.jpg" alt="Students collaborating and planning their futures" class="about-hero-image" />
    <div class="about-hero-shade"></div>
    <div class="container about-hero-content">
        <span class="landing-slide-kicker">ABOUT INTERLANE</span>
        <h1>Opening doors to<br />meaningful experience.</h1>
        <p>We bring ambitious students and forward-thinking companies together to make the first step into work more accessible.</p>
        <a asp-controller="Internships" asp-action="Index" class="btn btn-light landing-slide-cta">Explore opportunities <i class="fas fa-arrow-right ms-2"></i></a>
    </div>
</section>

<section class="about-intro container py-5">
    <div class="about-intro-mark"><i class="fas fa-compass" aria-hidden="true"></i></div>
    <div>
        <span class="public-eyebrow">OUR PURPOSE</span>
        <h2>Talent is everywhere.<br />Opportunity should be too.</h2>
        <p>Interlane helps students find practical experience where they can learn, contribute, and grow. We give companies a simple way to meet emerging talent and build their future teams.</p>
    </div>
</section>

<section class="about-journey-section">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="public-eyebrow">HOW IT WORKS</span>
            <h2 class="about-section-title">A clearer path from learning to doing</h2>
        </div>
        <div class="row g-4 about-steps">
            <div class="col-md-4">
                <article class="about-step-card">
                    <span class="about-step-number">01</span>
                    <span class="about-step-icon"><i class="fas fa-user-graduate" aria-hidden="true"></i></span>
                    <h3>Students show their strengths</h3>
                    <p>Create a profile, share your skills, and discover opportunities that fit your goals.</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="about-step-card">
                    <span class="about-step-number">02</span>
                    <span class="about-step-icon"><i class="fas fa-building" aria-hidden="true"></i></span>
                    <h3>Companies meet new talent</h3>
                    <p>Share meaningful placements and connect with motivated future professionals.</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="about-step-card">
                    <span class="about-step-number">03</span>
                    <span class="about-step-icon"><i class="fas fa-handshake" aria-hidden="true"></i></span>
                    <h3>Good matches get moving</h3>
                    <p>Students apply, employers connect, and hands-on experience begins.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="about-values container py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <img src="~/images/landing-career-success.jpg" alt="Students celebrating a new opportunity together" class="about-values-image" />
        </div>
        <div class="col-lg-6">
            <span class="public-eyebrow">WHAT GUIDES US</span>
            <h2 class="about-section-title mb-4">Built around people and possibility</h2>
            <div class="about-value"><span><i class="fas fa-shield-heart" aria-hidden="true"></i></span><div><h3>Trust</h3><p>We aim to make every connection clear, respectful, and reliable.</p></div></div>
            <div class="about-value"><span><i class="fas fa-lightbulb" aria-hidden="true"></i></span><div><h3>Growth</h3><p>We value practical learning that helps people build confidence and skills.</p></div></div>
            <div class="about-value"><span><i class="fas fa-people-group" aria-hidden="true"></i></span><div><h3>Opportunity</h3><p>We believe strong careers can begin with one meaningful experience.</p></div></div>
        </div>
    </div>
</section>

<section class="about-contact">
    <div class="container about-contact-inner">
        <div><span class="public-eyebrow">LET'S CONNECT</span><h2>Have a question or want to work with us?</h2></div>
        <a href="mailto:info@interlane.com" class="btn btn-light">Contact Interlane <i class="fas fa-arrow-right ms-2"></i></a>
    </div>
</section>
