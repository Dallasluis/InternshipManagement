@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <h1 class="display-5 fw-bold mb-4">About Us</h1>

    <div class="row">
        <div class="col-lg-8">
            <!-- Who We Are -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold text-primary">Who We Are</h4>
                    <p>InternshipHub is a leading platform dedicated to connecting students with meaningful internship opportunities. Founded by a team of professionals passionate about education and career development, we believe that internships are a vital stepping stone in building a successful career.</p>
                    <p>Our mission is to bridge the gap between talented students and companies looking for fresh perspectives and motivated individuals. Whether you are a student seeking hands-on experience or a company looking to nurture future talent, InternshipHub is here to make the connection seamless.</p>
                </div>
            </div>

            <!-- Our Mission -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold text-primary">Our Mission</h4>
                    <p>To empower students by providing access to quality internship opportunities and helping companies find the next generation of leaders.</p>
                    <ul>
                        <li><strong>Empower Students:</strong> Give students the tools, resources, and opportunities to succeed.</li>
                        <li><strong>Support Companies:</strong> Help businesses discover and nurture emerging talent.</li>
                        <li><strong>Build Community:</strong> Foster a network of students, professionals, and organizations.</li>
                    </ul>
                </div>
            </div>

            <!-- How It Works -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold text-primary">How It Works</h4>
                    <ol>
                        <li><strong>Students</strong> create a profile, upload their CV, and browse internships.</li>
                        <li><strong>Companies</strong> post internships, review applicants, and shortlist candidates.</li>
                        <li><strong>Matches</strong> happen when students apply and companies review applications.</li>
                        <li><strong>Hiring</strong> begins when companies shortlist, interview, and offer internships.</li>
                    </ol>
                </div>
            </div>

            <!-- Who It's For -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold text-primary">Who It's For</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-user-graduate text-primary me-2"></i> Students</h6>
                            <p class="text-muted">Undergraduates, graduates, and anyone looking for internship experience.</p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-building text-primary me-2"></i> Companies</h6>
                            <p class="text-muted">Startups, SMEs, and large corporations seeking talented interns.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold">Our Values</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Integrity:</strong> We operate with honesty and transparency.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Innovation:</strong> We strive for continuous improvement.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Community:</strong> We believe in the power of connection.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Empowerment:</strong> We help students and companies achieve their goals.
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">Get in Touch</h5>
                    <p class="text-muted">Have questions or want to collaborate?</p>
                    <a href="mailto:info@internshiphub.com" class="btn btn-primary w-100">
                        <i class="fas fa-envelope me-2"></i> Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>