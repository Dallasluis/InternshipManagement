@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <h1 class="mb-4">Privacy Policy</h1>
    <p class="text-muted">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>Information We Collect</h5>
            <p>We collect information you provide directly to us, such as when you create an account, fill out your profile, or apply for internships.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>How We Use Your Information</h5>
            <ul>
                <li>To create and manage your account</li>
                <li>To match you with internship opportunities</li>
                <li>To communicate with you about applications</li>
                <li>To improve our platform and services</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>Data Security</h5>
            <p>We implement appropriate technical and organizational measures to protect your personal information.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5>Contact Us</h5>
            <p>If you have any questions about this Privacy Policy, please contact us at <a href="mailto:privacy@internshiphub.com">privacy@internshiphub.com</a>.</p>
        </div>
    </div>
</div>