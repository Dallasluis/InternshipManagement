@{
    ViewData["Title"] = "Welcome";
    var userFullName = Context.Session.GetString("UserFullName");
}

<section class="landing-hero">
    <div id="landingHeroCarousel" class="carousel slide landing-carousel" data-bs-ride="carousel" data-bs-interval="6000" data-bs-pause="hover" aria-label="Career opportunities">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/landing-career-success.jpg" class="landing-slide-image" alt="Two students excitedly looking at a laptop together" />
                <div class="landing-slide-shade"></div>
                <div class="container landing-slide-content">
                    <span class="landing-slide-kicker">Built for Namibia’s next generation</span>
                    <h1>Find an internship<br />that moves you forward.</h1>
                    <p>Discover opportunities across Namibia, build practical skills, and take your first step into the world of work.</p>
                    <a asp-controller="Internships" asp-action="Index" class="btn btn-light landing-slide-cta">Explore internships <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/landing-teamwork.jpg" class="landing-slide-image" alt="A diverse group of students collaborating around a table" />
                <div class="landing-slide-shade"></div>
                <div class="container landing-slide-content">
                    <span class="landing-slide-kicker">For Namibian employers</span>
                    <h2>Grow local talent.<br />Build your future team.</h2>
                    <p>Share a meaningful internship and connect with students ready to contribute and learn.</p>
                    <a asp-controller="Account" asp-action="Register" asp-route-userType="Company" class="btn btn-light landing-slide-cta">Hire an intern <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev landing-carousel-control" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="prev" aria-label="Previous slide">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next landing-carousel-control" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="next" aria-label="Next slide">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</section>

<section class="landing-search-section">
    <div class="container landing-search-wrap">
        <form asp-controller="Internships" asp-action="Index" method="get" class="landing-search">
            <div class="landing-search-heading">
                <span class="landing-search-icon"><i class="fas fa-search" aria-hidden="true"></i></span>
                <span><strong>Find your next internship</strong><small>Explore placements across Namibia by role, location, industry, or work style</small></span>
            </div>
            <div class="landing-search-controls">
                <label class="landing-search-field">
                    <span class="visually-hidden">Role, skill, or company</span>
                    <i class="fas fa-briefcase" aria-hidden="true"></i>
                    <input type="search" name="Keyword" class="form-control" placeholder="Role, skill, or company" />
                </label>
                <label class="landing-search-field">
                    <span class="visually-hidden">Location</span>
                    <i class="fas fa-location-dot" aria-hidden="true"></i>
                    <input type="text" name="Location" class="form-control" placeholder="Location" data-location-picker data-location-mode="city" data-location-popover />
                </label>
                <label class="landing-search-field">
                    <span class="visually-hidden">Industry</span>
                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                    <input type="text" name="Industry" class="form-control" placeholder="Industry" data-categories />
                </label>
                <label class="landing-search-field">
                    <span class="visually-hidden">Work arrangement</span>
                    <i class="fas fa-laptop-house" aria-hidden="true"></i>
                    <select name="WorkArrangement" class="form-select">
                        <option value="">Any work style</option>
                        <option value="OnSite">On-site</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Remote">Remote</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary"><span>Search</span><i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></button>
            </div>
        </form>
    </div>
</section>

<section class="how-it-works">
    <div class="container">
        <div class="how-heading"><span class="public-eyebrow">A SIMPLE WAY TO CONNECT</span><h2>How it works</h2><p>Whether you’re looking for experience or welcoming new talent, Interlane helps you get there.</p></div>
        <div id="howItWorksCarousel" class="carousel slide how-carousel" data-bs-interval="false" aria-label="How Interlane works for students and companies">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="how-slide" aria-roledescription="slide" aria-label="1 of 2: For students">
                        <div class="how-slide-intro"><span class="how-role-icon"><i class="fas fa-user-graduate" aria-hidden="true"></i></span><span class="public-eyebrow">FOR STUDENTS</span><h3>Turn your ambition into experience.</h3><p>Find a placement that fits your skills and take the next step in your career.</p><a asp-controller="Internships" asp-action="Index" class="btn btn-primary rounded-pill px-4">Find a placement <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></a></div>
                        <div class="how-steps">
                            <article class="how-step"><span class="how-step-number">01</span><span class="how-step-icon"><i class="fas fa-id-card" aria-hidden="true"></i></span><h4>Create your profile</h4><p>Share your interests, education, and skills.</p></article>
                            <article class="how-step"><span class="how-step-number">02</span><span class="how-step-icon"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></span><h4>Explore opportunities</h4><p>Search placements and find your best fit.</p></article>
                            <article class="how-step"><span class="how-step-number">03</span><span class="how-step-icon"><i class="fas fa-paper-plane" aria-hidden="true"></i></span><h4>Apply and grow</h4><p>Send your application and start building experience.</p></article>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="how-slide" aria-roledescription="slide" aria-label="2 of 2: For companies">
                        <div class="how-slide-intro"><span class="how-role-icon"><i class="fas fa-building" aria-hidden="true"></i></span><span class="public-eyebrow">FOR COMPANIES</span><h3>Meet the next generation of talent.</h3><p>Share meaningful internship roles and connect with motivated candidates.</p><a asp-controller="Account" asp-action="Register" asp-route-userType="Company" class="btn btn-primary rounded-pill px-4">Hire an intern <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></a></div>
                        <div class="how-steps">
                            <article class="how-step"><span class="how-step-number">01</span><span class="how-step-icon"><i class="fas fa-building-circle-check" aria-hidden="true"></i></span><h4>Set up your company</h4><p>Create a company profile and introduce your team.</p></article>
                            <article class="how-step"><span class="how-step-number">02</span><span class="how-step-icon"><i class="fas fa-rectangle-list" aria-hidden="true"></i></span><h4>Post an opportunity</h4><p>Describe the role, skills, and experience you offer.</p></article>
                            <article class="how-step"><span class="how-step-number">03</span><span class="how-step-icon"><i class="fas fa-users-viewfinder" aria-hidden="true"></i></span><h4>Connect with candidates</h4><p>Review applications and find your next intern.</p></article>
                        </div>
                    </div>
                </div>
            </div>
            <div class="how-carousel-controls">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#howItWorksCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Students"></button>
                    <button type="button" data-bs-target="#howItWorksCarousel" data-bs-slide-to="1" aria-label="Companies"></button>
                </div>
                <div class="how-carousel-arrows"><button type="button" data-bs-target="#howItWorksCarousel" data-bs-slide="prev" aria-label="Previous role"><i class="fas fa-arrow-left" aria-hidden="true"></i></button><button type="button" data-bs-target="#howItWorksCarousel" data-bs-slide="next" aria-label="Next role"><i class="fas fa-arrow-right" aria-hidden="true"></i></button></div>
            </div>
        </div>
    </div>
</section>

<section class="why-section">
    <div class="container">
        <div class="marketplace-heading"><span class="public-eyebrow">MADE FOR THE LOCAL JOURNEY</span><h2>More than a list of internships</h2><p>Interlane brings students and Namibian employers together, with tools to make each step clearer.</p></div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img"><i class="fas fa-map-location-dot" aria-hidden="true"></i></div>
                    <div class="why-card-body">
                        <h6>Find placements that fit</h6>
                        <p class="text-muted small mb-0">Explore opportunities by field, location, work style, and stipend, then see matches tailored to your profile.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img"><i class="fas fa-route" aria-hidden="true"></i></div>
                    <div class="why-card-body">
                        <h6>Keep your search moving</h6>
                        <p class="text-muted small mb-0">Save internships, prepare your documents, apply, and follow application updates from one place.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img"><i class="fas fa-people-group" aria-hidden="true"></i></div>
                    <div class="why-card-body">
                        <h6>Help local talent get started</h6>
                        <p class="text-muted small mb-0">Employers can present their company, share clear internship roles, and manage candidate applications.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-banner">
    <h2 class="mb-3">Your next step starts here</h2>
    <p class="mb-4">Find a placement or help grow Namibia’s next generation of talent.</p>
    @if (!string.IsNullOrEmpty(userFullName))
    {
        <a asp-controller="Internships" asp-action="Index" class="btn btn-light">Browse Internships</a>
    }
    else
    {
        <div class="landing-cta-actions"><a asp-controller="Account" asp-action="Register" asp-route-userType="Student" class="btn btn-light">I’m looking for an internship</a><a asp-controller="Account" asp-action="Register" asp-route-userType="Company" class="btn btn-outline-light">I’m hiring interns</a></div>
    }
</section>
