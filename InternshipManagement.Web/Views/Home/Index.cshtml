@{
    ViewData["Title"] = "Welcome";
    var userFullName = Context.Session.GetString("UserFullName");
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1 class="display-5 mb-3">Transform Your Future with Top Internship Opportunities</h1>
                <p class="lead text-muted mb-4">
                    Explore top internship placements with leading companies and
                    take your career to the next level.
                </p>
                <form asp-controller="Internships" asp-action="Index" method="get">
                    <div class="search-pill d-flex p-2 mb-2" style="max-width: 480px;">
                        <input type="text" name="Keyword" class="form-control" placeholder="Search internships..." />
                        <button type="submit" class="btn btn-dark px-4">Search</button>
                    </div>
                </form>
                <small class="text-muted">Popular: Software Development, Design, Marketing, Data Analysis</small>
            </div>
            <div class="col-lg-6">
                <div class="hero-illustration">🎓</div>
            </div>
        </div>
    </div>
</section>

<section class="how-it-works">
    <div class="container">
        <h2 class="text-center mb-5">How it works</h2>
        <div class="row mb-5">
            <div class="col-12 text-center mb-4">
                <h5 class="text-uppercase text-muted">For Students</h5>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="step-icon">👤</div>
                <h6>Sign up / Log in</h6>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="step-icon">🔍</div>
                <h6>Find relevant opportunities</h6>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="step-icon">✅</div>
                <h6>Apply with no hassle</h6>
            </div>
            <div class="col-12 text-center">
                <a asp-controller="Internships" asp-action="Index" class="btn btn-dark rounded-pill px-4">Find placement</a>
            </div>
        </div>
    </div>
</section>

<section class="why-section">
    <div class="container">
        <h2 class="text-center mb-5">Why Choose Our Platform?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img">🎯</div>
                    <div class="why-card-body">
                        <h6>Personalized Internship Matches</h6>
                        <p class="text-muted small mb-0">Recommendations tailored to your profile and interests.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img">✔️</div>
                    <div class="why-card-body">
                        <h6>Verified Students and Recruiters</h6>
                        <p class="text-muted small mb-0">Every profile is reviewed before it goes live.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-card">
                    <div class="why-card-img">📋</div>
                    <div class="why-card-body">
                        <h6>Easy Posting for Recruiters</h6>
                        <p class="text-muted small mb-0">Post a role and start reviewing applicants in minutes.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-banner">
    <h2 class="mb-3">Ready to Get Started?</h2>
    <p class="mb-4">Join students and recruiters shaping the future together.</p>
    @if (!string.IsNullOrEmpty(userFullName))
    {
        <a asp-controller="Internships" asp-action="Index" class="btn btn-light">Browse Internships</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-light">Get started</a>
    }
</section>