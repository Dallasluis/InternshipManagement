@model List<InternshipManagement.Web.Models.Application.ApplicationResponse>
@{
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Applications</h1>
        <p class="text-muted">Review and manage all internship applications</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-users fa-4x text-muted mb-3"></i>
        <h5>No Applications Yet</h5>
        <p class="text-muted">Students haven't applied to your internships yet.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Programme</th>
                            <th>Internship</th>
                            <th>Applied</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.OrderByDescending(a => a.AppliedAt))
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle-sm me-2">@app.Student?.FullName?.FirstOrDefault()</div>
                                        <div>
                                            <div class="fw-bold">@app.Student?.FullName</div>
                                            <small class="text-muted">@app.Student?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@app.Student?.Programme</td>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@app.InternshipId" class="text-decoration-none">
                                        @app.InternshipTitle
                                    </a>
                                </td>
                                <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(app.Status)">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <!-- View Details -->
                                        <a asp-controller="Company" asp-action="ApplicationReview" asp-route-id="@app.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <!-- Shortlist (only for Applied or UnderReview) -->
                                        @if (app.Status == "Applied" || app.Status == "UnderReview")
                                        {
                                            <form asp-controller="Company" asp-action="ShortlistApplication" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Shortlist this applicant?')">
                                                    <i class="fas fa-star"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Reject (only if not already rejected/withdrawn) -->
                                        @if (app.Status != "Rejected" && app.Status != "Withdrawn")
                                        {
                                            <form asp-controller="Company" asp-action="RejectApplication" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this application?')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<style>
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        background: #e0f2fe;
        color: #2563eb;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
        flex-shrink: 0;
    }
</style>