@model List<InternshipManagement.Web.Models.Application.ApplicationResponse>
@{
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Applications</h1>
        <p class="text-muted">Review and manage all internship applications</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-users fa-4x text-muted mb-3"></i>
        <h5>No Applications Yet</h5>
        <p class="text-muted">Students haven't applied to your internships yet.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Programme</th>
                            <th>Internship</th>
                            <th>Applied</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.OrderByDescending(a => a.AppliedAt))
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle-sm me-2">@app.Student?.FullName?.FirstOrDefault()</div>
                                        <div>
                                            <div class="fw-bold">@app.Student?.FullName</div>
                                            <small class="text-muted">@app.Student?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@app.Student?.Programme</td>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@app.InternshipId" class="text-decoration-none">
                                        @app.InternshipTitle
                                    </a>
                                </td>
                                <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(app.Status)">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Company" asp-action="ApplicationReview" asp-route-id="@app.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (app.Status == "Applied" || app.Status == "UnderReview")
                                    {
                                        <button class="btn btn-sm btn-success" onclick="shortlistApplication(@app.Id)">
                                            <i class="fas fa-star"></i>
                                        </button>
                                    }
                                    @if (app.Status != "Rejected" && app.Status != "Withdrawn")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" onclick="rejectApplication(@app.Id)">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script>
        function shortlistApplication(id) {
            if (confirm('Shortlist this applicant?')) {
                fetch(`/api/applications/${id}/shortlist`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notes: '' })
                })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        }
                    })
                    .catch(error => {
                        alert('Failed to shortlist. Please try again.');
                    });
            }
        }

        function rejectApplication(id) {
            if (confirm('Reject this application?')) {
                fetch(`/api/applications/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'Rejected', notes: '' })
                })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        }
                    })
                    .catch(error => {
                        alert('Failed to reject. Please try again.');
                    });
            }
        }
    </script>
}

<style>
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        background: #e0f2fe;
        color: #2563eb;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
        flex-shrink: 0;
    }
</style>