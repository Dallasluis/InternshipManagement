@model InternshipManagement.Web.Models.Internship.UpdateInternshipRequest
@{
    ViewData["Title"] = "Edit Internship";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <h1 class="h2 mb-3">Edit Internship</h1>
        <p class="text-muted mb-4">Update the internship details below.</p>

        <div class="card">
            <div class="card-body">
                <form asp-controller="Company" asp-action="EditInternship" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Same fields as CreateInternship.cshtml -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Add rest of the fields same as CreateInternship.cshtml -->

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Update Internship
                    </button>
                    <a asp-controller="Company" asp-action="ManageInternships" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>