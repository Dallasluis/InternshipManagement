@model InternshipManagement.Web.Models.Internship.UpdateInternshipRequest
@{
    ViewData["Title"] = "Edit Internship";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <h1 class="h2 mb-3">Edit Internship</h1>
        <p class="text-muted mb-4">Update the internship details below.</p>

        <div class="card">
            <div class="card-body">
                <form asp-controller="Company" asp-action="EditInternship" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Responsibilities" class="form-label"></label>
                        <textarea asp-for="Responsibilities" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requirements" class="form-label"></label>
                        <textarea asp-for="Requirements" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RequiredQualifications" class="form-label">Required Qualifications</label>
                            <textarea asp-for="RequiredQualifications" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PreferredQualifications" class="form-label">Preferred Qualifications</label>
                            <textarea asp-for="PreferredQualifications" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Industry" class="form-label"></label>
                            <input asp-for="Industry" class="form-control" data-categories />
                            <span asp-validation-for="Industry" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="Search or pick on the map" data-location-picker />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Schedule</label>
                            <input type="hidden" asp-for="InternshipType" value="FullTime" />
                            <input class="form-control" value="Full-time" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WorkArrangement" class="form-label">Work arrangement</label>
                            <select asp-for="WorkArrangement" class="form-select">
                                <option value="OnSite">On-site</option>
                                <option value="Remote">Remote</option>
                                <option value="Hybrid">Hybrid</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Duration" class="form-label"></label>
                            <select asp-for="Duration" class="form-select">
                                <option value="LessThan3Months">Less than 3 months</option>
                                <option value="ThreeToSixMonths">3 to 6 months</option>
                                <option value="SixToTwelveMonths">6 to 12 months</option>
                                <option value="MoreThanTwelveMonths">More than 12 months</option>
                            </select>
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ApplicationDeadline" class="form-label"></label>
                            <input asp-for="ApplicationDeadline" type="date" class="form-control" />
                            <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumberOfPositions" class="form-label"></label>
                            <input asp-for="NumberOfPositions" type="number" class="form-control" min="1" />
                            <span asp-validation-for="NumberOfPositions" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Compensation" class="form-label"></label>
                            <select asp-for="Compensation" class="form-select">
                                <option value="">Select compensation type</option>
                                <option value="Paid">Paid</option>
                                <option value="Stipend">Stipend</option>
                                <option value="Unpaid">Unpaid</option>
                            </select>
                        </div>
                    </div>

                    <div id="stipendFields" style="display: none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StipendAmount" class="form-label"></label>
                                <input asp-for="StipendAmount" type="number" class="form-control" step="0.01" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Currency" class="form-label"></label>
                                <input asp-for="Currency" class="form-control" placeholder="USD" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label"></label>
                        <input asp-for="Skills" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RequiredSkills" class="form-label">Required Skills</label>
                            <textarea asp-for="RequiredSkills" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PreferredSkills" class="form-label">Preferred Skills</label>
                            <textarea asp-for="PreferredSkills" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EligibleProgrammes" class="form-label">Eligible Programmes</label>
                        <input id="EligibleProgrammes" name="EligibleProgrammes" class="form-control" value="@string.Join(", ", Model.EligibleProgrammes ?? new List<string>())" placeholder="Comma separated, e.g., Computer Science, Engineering" />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Update Internship
                    </button>
                    <a asp-controller="Company" asp-action="ManageInternships" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const compensation = document.querySelector('#Compensation');
        const stipendFields = document.querySelector('#stipendFields');

        function toggleStipendFields() {
            stipendFields.style.display = compensation.value === 'Stipend' ? 'block' : 'none';
        }

        compensation.addEventListener('change', toggleStipendFields);
        toggleStipendFields();
    </script>
}
