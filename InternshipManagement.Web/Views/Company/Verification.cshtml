@model InternshipManagement.Web.Models.Company.SubmitVerificationRequest
@{
    ViewData["Title"] = "Company Verification";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="h2 mb-3">Company Verification</h1>
        <p class="text-muted mb-4">
            Submit your verification documents to prove your company's legitimacy.
            This helps build trust with students applying to your internships.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="card">
            <div class="card-body">
                <form asp-controller="Company" asp-action="Verification" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Please provide the following documents:
                        <ul class="mb-0 mt-2">
                            <li>Business Registration Certificate</li>
                            <li>Tax Identification Number</li>
                            <li>Company Bank Details</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EvidenceFiles" class="form-label">Verification documents</label>
                        <input asp-for="EvidenceFiles" type="file" class="form-control" multiple
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Upload your business registration and tax evidence. Files must be 10 MB or smaller.</small>
                        <span asp-validation-for="EvidenceFiles" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Notes</label>
                        <textarea name="Notes" class="form-control" rows="2"
                                  placeholder="Any additional information for the admin..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-1"></i> Submit Verification
                    </button>
                    <a asp-controller="Company" asp-action="Dashboard" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
            @if (ViewBag.Profile is InternshipManagement.Web.Models.Company.CompanyProfileResponse profile
                && profile.VerificationStatus == "Rejected"
                && !profile.HasUsedVerificationAppeal)
            {
                <div class="card mt-4">
                    <div class="card-header bg-white"><h6 class="mb-0">Appeal the decision</h6></div>
                    <div class="card-body">
                        <p class="text-muted">You may appeal once within 30 days of the rejection. A different administrator will review it.</p>
                        <form asp-controller="Company" asp-action="AppealVerification" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="Reason" class="form-label">Reason for appeal</label>
                                <textarea id="Reason" name="Reason" class="form-control" rows="4" minlength="20" maxlength="2000" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-primary">Submit appeal</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>