@model InternshipManagement.Web.Models.Company.SubmitVerificationRequest
@{
    ViewData["Title"] = "Company Verification";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="h2 mb-3">Company Verification</h1>
        <p class="text-muted mb-4">
            Submit your verification documents to prove your company's legitimacy.
            This helps build trust with students applying to your internships.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="card">
            <div class="card-body">
                <form asp-controller="Company" asp-action="Verification" method="post">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Please provide the following documents:
                        <ul class="mb-0 mt-2">
                            <li>Business Registration Certificate</li>
                            <li>Tax Identification Number</li>
                            <li>Company Bank Details</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Verification Documents</label>
                        <textarea name="VerificationDocuments" class="form-control" rows="3"
                                  placeholder="Provide details about your verification documents..."></textarea>
                        <small class="text-muted">Describe the documents you have for verification.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Notes</label>
                        <textarea name="Notes" class="form-control" rows="2"
                                  placeholder="Any additional information for the admin..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-1"></i> Submit Verification
                    </button>
                    <a asp-controller="Company" asp-action="Dashboard" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>