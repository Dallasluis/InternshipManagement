@model InternshipManagement.Web.ViewModels.CompanyDashboardViewModel
@{
    ViewData["Title"] = "Company Dashboard";
}
@section Styles { <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /> }

<div class="dash">
    <section class="role-welcome company-welcome dash-in">
        <div class="role-welcome-copy">
            <div class="dash-date" id="dash-date"></div>
            <h1><span id="dash-greeting">Welcome back</span>, @(Model.Profile?.CompanyName ?? "your team")</h1>
            <p>@(Model.TotalApplications == 0 ? "Post an internship to start receiving applications." : $"{Model.TotalApplications} application{(Model.TotalApplications == 1 ? "" : "s")} across your internships.")</p>
            <a asp-controller="Company" asp-action="CreateInternship" class="btn btn-light"><i class="fas fa-plus me-2"></i>Post a new internship <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
        <div class="role-welcome-art" aria-hidden="true"><i class="fas fa-building"></i><i class="fas fa-chart-line"></i><span></span></div>
        <a asp-controller="Company" asp-action="ManageInternships" class="role-welcome-link"><i class="fas fa-list me-1"></i>Manage listings <i class="fas fa-arrow-right ms-1"></i></a>
    </section>

    @if (!Model.IsVerified)
    {
        <a class="dash-tile alert-tile mb-3 dash-in" style="--tile:#d97706" asp-controller="Company" asp-action="Verification">
            <span class="ico"><i class="fas fa-shield-alt"></i></span>
            <span><div class="fw-semibold">Company verification is required before publishing</div><div class="sub">Submit your company documents for review, then publish internships immediately once verified.</div></span>
            <span class="ms-auto text-muted"><i class="fas fa-chevron-right"></i></span>
        </a>
    }

    <div class="dash-section-label dash-in"><span>Hiring overview</span><span>Current activity across your listings</span></div>
    <div class="row g-3 mb-3">
        <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#2563eb" asp-controller="Company" asp-action="ManageInternships"><span class="ico"><i class="fas fa-briefcase"></i></span><span><div class="num" data-count="@Model.TotalInternships">@Model.TotalInternships</div><div class="lbl">Internships</div></span></a></div>
        <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#059669" asp-controller="Company" asp-action="ManageInternships"><span class="ico"><i class="fas fa-bullhorn"></i></span><span><div class="num" data-count="@Model.ActiveInternships">@Model.ActiveInternships</div><div class="lbl">Published</div></span></a></div>
        <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#d97706" asp-controller="Company" asp-action="ManageInternships"><span class="ico"><i class="fas fa-users"></i></span><span><div class="num" data-count="@Model.TotalApplications">@Model.TotalApplications</div><div class="lbl">Applications</div></span></a></div>
        <div class="col-md-3 col-6 dash-in"><a class="dash-tile" style="--tile:#7c3aed" asp-controller="Company" asp-action="ManageInternships"><span class="ico"><i class="fas fa-star"></i></span><span><div class="num" data-count="@Model.ShortlistedCount">@Model.ShortlistedCount</div><div class="lbl">Shortlisted</div></span></a></div>
    </div>

    <div class="row g-3">
    <div class="col-lg-7 dash-in"><div class="dash-card" style="height:auto">
        <div class="head">
            <h2><i class="fas fa-briefcase me-2 text-success"></i>Your internships</h2>
            <a asp-controller="Company" asp-action="ManageInternships" class="small">View all <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
        @if (Model.RecentInternships.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>Title</th><th>Arrangement</th><th>Applications</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var internship in Model.RecentInternships)
                    {
                        <tr>
                            <td class="fw-semibold">@internship.Title</td>
                            <td class="text-muted">@internship.WorkArrangement</td>
                            <td><span class="badge text-bg-light border">@internship.ApplicationsCount</span></td>
                            <td><span class="badge @InternshipManagement.Web.Helpers.StatusDisplay.Badge(internship.Status)">@InternshipManagement.Web.Helpers.StatusDisplay.Label(internship.Status)</span></td>
                            <td class="text-end"><a asp-controller="Internships" asp-action="Details" asp-route-id="@internship.Id" class="btn btn-sm btn-outline-primary" aria-label="View internship"><i class="fas fa-arrow-right"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="dash-empty"><div class="big"><i class="fas fa-briefcase"></i></div><p class="mb-2">No internships posted yet.</p><a asp-controller="Company" asp-action="CreateInternship" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> Post your first internship</a></div>
        }
    </div></div>
    <div class="col-lg-5 dash-in"><div class="dash-card" style="height:auto">
        <div class="head"><h2><i class="fas fa-user-clock me-2 text-success"></i>Recent applicants</h2><a asp-controller="Company" asp-action="Applications" class="small">View all <i class="fas fa-arrow-right ms-1"></i></a></div>
        @if (Model.RecentApplications.Any())
        {
            <div class="company-applicant-list">
                @foreach (var application in Model.RecentApplications)
                {
                    <a asp-controller="Company" asp-action="ApplicationReview" asp-route-id="@application.Id" class="company-applicant">
                        <span class="company-applicant-avatar">@(application.Student?.FullName?.FirstOrDefault() ?? 'S')</span>
                        <span class="company-applicant-copy"><strong>@(application.Student?.FullName ?? "Student")</strong><small>@application.InternshipTitle</small></span>
                        <span class="badge @InternshipManagement.Web.Helpers.StatusDisplay.Badge(application.Status)">@InternshipManagement.Web.Helpers.StatusDisplay.Label(application.Status)</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="dash-empty"><div class="big"><i class="fas fa-users"></i></div>No applications yet. Published internships will appear to students immediately.</div>
        }
    </div></div>
    </div>
</div>

@section Scripts { <script src="~/js/dashboard.js" asp-append-version="true"></script> }
