@model InternshipManagement.Web.Models.Internship.CreateInternshipRequest
@{
    ViewData["Title"] = "Post New Internship";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <h1 class="h2 mb-3">Post New Internship</h1>
        <p class="text-muted mb-4">Fill in the details below to create a new internship opportunity.</p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div id="ai-root" data-page="draft"
             data-login-url="@Url.Action("Login", "Account")"
             data-generate-url="@Url.Action("GenerateDraft", "CompanyAi")"
             data-drafts-url="@Url.Action("Drafts", "CompanyAi")"
             data-draft-url="@Url.Action("Draft", "CompanyAi")"
             data-delete-url="@Url.Action("DeleteDraft", "CompanyAi")">
            <div class="card mb-4 border-primary">
                <div class="card-body">
                    <h2 class="h5 mb-1"><i class="fas fa-magic me-1"></i> Write it with AI</h2>
                    <p class="small text-muted mb-2">
                        Describe the role in a few sentences (what the intern will do, skills, duration). The AI fills in the form below.
                        You then check and complete it before creating the internship.
                    </p>
                    <textarea id="draft-prompt" class="form-control mb-1" rows="3" maxlength="4000"
                              placeholder="e.g., Junior accounting intern at a Windhoek firm, 6 months, on-site. Does reconciliations and invoice capture. For accounting students. Required: Excel, bookkeeping basics. Nice to have: Pastel."></textarea>
                    <div class="small text-muted text-end mb-2"><span id="draft-count">0 / 4000</span></div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button id="draft-btn" type="button" class="btn btn-primary">Generate draft</button>
                        <select id="draft-saved" class="form-select form-select-sm w-auto d-none" aria-label="Load a saved draft">
                            <option value="">Load a saved draft…</option>
                        </select>
                    </div>
                    <div id="draft-errors" class="mt-2"></div>
                    <div id="draft-result" class="mt-2"></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-controller="Company" asp-action="CreateInternship" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Software Developer Intern" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe the internship role and responsibilities..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Responsibilities" class="form-label"></label>
                        <textarea asp-for="Responsibilities" class="form-control" rows="3"
                                  placeholder="List the key responsibilities..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requirements" class="form-label"></label>
                        <textarea asp-for="Requirements" class="form-control" rows="3"
                                  placeholder="List general requirements..."></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RequiredQualifications" class="form-label">Required Qualifications</label>
                            <textarea asp-for="RequiredQualifications" class="form-control" rows="3"
                                      placeholder="Qualifications applicants must have..."></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PreferredQualifications" class="form-label">Preferred Qualifications</label>
                            <textarea asp-for="PreferredQualifications" class="form-control" rows="3"
                                      placeholder="Qualifications that would be helpful..."></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Industry" class="form-label"></label>
                            <input asp-for="Industry" class="form-control" placeholder="Choose or type an industry" data-categories />
                            <span asp-validation-for="Industry" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="Search or pick on the map" data-location-picker />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Schedule</label>
                            <input type="hidden" asp-for="InternshipType" value="FullTime" />
                            <input class="form-control" value="Full-time" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WorkArrangement" class="form-label">Work arrangement</label>
                            <select asp-for="WorkArrangement" class="form-select">
                                <option value="OnSite">On-site</option>
                                <option value="Remote">Remote</option>
                                <option value="Hybrid">Hybrid</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Duration" class="form-label"></label>
                            <select asp-for="Duration" class="form-select">
                                <option value="LessThan3Months">Less than 3 months</option>
                                <option value="ThreeToSixMonths">3 to 6 months</option>
                                <option value="SixToTwelveMonths">6 to 12 months</option>
                                <option value="MoreThanTwelveMonths">More than 12 months</option>
                            </select>
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ApplicationDeadline" class="form-label"></label>
                            <input asp-for="ApplicationDeadline" type="date" class="form-control" />
                            <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumberOfPositions" class="form-label"></label>
                            <input asp-for="NumberOfPositions" type="number" class="form-control" min="1" />
                            <span asp-validation-for="NumberOfPositions" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Compensation" class="form-label"></label>
                            <select asp-for="Compensation" class="form-select">
                                <option value="">Select compensation type</option>
                                <option value="Paid">Paid</option>
                                <option value="Stipend">Stipend</option>
                                <option value="Unpaid">Unpaid</option>
                            </select>
                        </div>
                    </div>

                    <div id="stipendFields" style="display: none;">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StipendAmount" class="form-label"></label>
                                <input asp-for="StipendAmount" type="number" class="form-control" step="0.01" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Currency" class="form-label"></label>
                                <input asp-for="Currency" class="form-control" placeholder="USD" value="USD" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label"></label>
                        <input asp-for="Skills" class="form-control" placeholder="e.g., C#, JavaScript, React, .NET Core" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RequiredSkills" class="form-label">Required Skills</label>
                            <textarea asp-for="RequiredSkills" class="form-control" rows="3"
                                      placeholder="Skills applicants must have, comma separated"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PreferredSkills" class="form-label">Preferred Skills</label>
                            <textarea asp-for="PreferredSkills" class="form-control" rows="3"
                                      placeholder="Nice-to-have skills, comma separated"></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EligibleProgrammes" class="form-label">Eligible Programmes</label>
                        <input asp-for="EligibleProgrammes" class="form-control" placeholder="e.g., Computer Science, Engineering, Business (comma separated)" />
                        <small class="text-muted">Enter the academic programmes eligible for this internship.</small>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Create Internship
                    </button>
                    <a asp-controller="Company" asp-action="ManageInternships" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/student-ai.css" asp-append-version="true" /> }

@section Scripts {
    <script src="~/js/company-ai.js" asp-append-version="true"></script>
    <script>
        document.querySelector('#Compensation').addEventListener('change', function () {
            const stipendFields = document.querySelector('#stipendFields');
            stipendFields.style.display = this.value === 'Stipend' ? 'block' : 'none';
        });
    </script>
}
