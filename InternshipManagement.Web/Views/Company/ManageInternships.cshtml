@model List<InternshipManagement.Web.Models.Internship.InternshipResponse>
@{
    ViewData["Title"] = "Manage Internships";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">My Internships</h1>
        <p class="text-muted">Manage all your internship postings</p>
    </div>
    <a asp-controller="Company" asp-action="CreateInternship" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Post New Internship
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-briefcase fa-4x text-muted mb-3"></i>
        <h5>No Internships Posted</h5>
        <p class="text-muted">You haven't posted any internships yet.</p>
        <a asp-controller="Company" asp-action="CreateInternship" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Post Your First Internship
        </a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Applications</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var internship in Model.OrderByDescending(i => i.PublishedAt ?? DateTime.Now))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@internship.Id" class="text-decoration-none">
                                        @internship.Title
                                    </a>
                                </td>
                                <td>@internship.InternshipType</td>
                                <td>@internship.ApplicationsCount</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(internship.Status)">
                                        @internship.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <!-- View Details -->
                                        <a asp-controller="Internships" asp-action="Details" asp-route-id="@internship.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <!-- Edit -->
                                        <a asp-controller="Company" asp-action="EditInternship" asp-route-id="@internship.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- Publish (only for Draft) -->
                                        @if (internship.Status == "Draft")
                                        {
                                            <form asp-controller="Company" asp-action="PublishInternship" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@internship.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to publish this internship?')">
                                                    <i class="fas fa-rocket"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Close (only for Published) -->
                                        @if (internship.Status == "Published")
                                        {
                                            <form asp-controller="Company" asp-action="CloseInternship" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@internship.Id" />
                                                <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Are you sure you want to close this internship?')">
                                                    <i class="fas fa-times-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Delete -->
                                        <form asp-controller="Company" asp-action="DeleteInternship" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@internship.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this internship? This cannot be undone.')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Draft" => "bg-secondary",
        "Published" => "bg-success",
        "Closed" => "bg-danger",
        "Filled" => "bg-info",
        _ => "bg-secondary"
    };
}