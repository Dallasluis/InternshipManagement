@model InternshipManagement.Web.ViewModels.ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Review Application";
    var application = Model.Application;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Review Application</h1>
        <p class="text-muted">@application.InternshipTitle</p>
    </div>
    <a asp-controller="Company" asp-action="Applications" class="btn btn-outline-secondary">Back to Applications</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5>@application.Student?.FullName</h5>
        <p class="text-muted mb-1">@application.Student?.Email</p>
        <p class="text-muted">@application.Student?.Programme at @application.Student?.University</p>

        <dl class="row">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @GetStatusBadgeClass(application.Status)">@application.Status</span></dd>
            <dt class="col-sm-3">Applied</dt>
            <dd class="col-sm-9">@application.AppliedAt.ToString("MMM d, yyyy")</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(application.CoverLetter))
        {
            <h6>Cover Letter</h6>
            <p class="border rounded p-3">@application.CoverLetter</p>
        }

        @if (!string.IsNullOrWhiteSpace(application.Student?.ResumeUrl))
        {
            <a href="@application.Student.ResumeUrl" target="_blank" rel="noopener" class="btn btn-primary">
                <i class="fas fa-file-pdf me-1"></i> View CV / Resume
            </a>
        }
        else
        {
            <p class="text-muted">This student has not provided a CV link.</p>
        }
    </div>
</div>

@if (application.Status == "Shortlisted" || application.Status == "InterviewScheduled" || application.Status == "InterviewCompleted" || application.Status == "OfferMade" || application.Status == "Accepted" || application.Status == "OfferDeclined")
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Interview Management</h5>
        </div>
        <div class="card-body">
            @if (application.InterviewDateTime.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    <strong>Interview:</strong> @application.InterviewDateTime.Value.ToString("MMM d, yyyy h:mm tt")<br />
                    <strong>Type:</strong> @application.InterviewType<br />
                    @if (!string.IsNullOrWhiteSpace(application.InterviewLocationOrLink))
                    {
                        <strong>Location/Link:</strong> <a href="@application.InterviewLocationOrLink" target="_blank" rel="noopener">@application.InterviewLocationOrLink</a><br />
                    }
                    @if (!string.IsNullOrWhiteSpace(application.InterviewNotes))
                    {
                        <strong>Notes:</strong> @application.InterviewNotes
                    }
                </div>
            }

            @if (application.Status == "Shortlisted")
            {
                <form asp-controller="Company" asp-action="ScheduleInterview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@application.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Interview Date</label>
                            <input type="datetime-local" class="form-control" name="InterviewDateTime" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Interview Type</label>
                            <input type="text" class="form-control" name="InterviewType" placeholder="Technical / HR / Final" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Location or Link</label>
                            <input type="text" class="form-control" name="InterviewLocationOrLink" placeholder="Zoom link / room number" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" name="InterviewNotes" rows="3"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Schedule Interview</button>
                </form>
            }

            @if (application.Status == "InterviewScheduled")
            {
                <form asp-controller="Company" asp-action="MarkInterviewCompleted" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@application.Id" />
                    <button type="submit" class="btn btn-success">Mark Interview Completed</button>
                </form>
            }
        </div>
    </div>
}

@if (application.Status == "InterviewCompleted" || application.Status == "OfferMade" || application.Status == "Accepted" || application.Status == "OfferDeclined")
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Offer Management</h5>
        </div>
        <div class="card-body">
            @if (application.OfferStipendAmount.HasValue || application.OfferStartDate.HasValue || !string.IsNullOrWhiteSpace(application.OfferDetails) || application.OfferExpiryDate.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    @if (application.OfferStipendAmount.HasValue)
                    {
                        <div><strong>Stipend:</strong> @application.OfferStipendAmount.Value.ToString("C")</div>
                    }
                    @if (application.OfferStartDate.HasValue)
                    {
                        <div><strong>Start Date:</strong> @application.OfferStartDate.Value.ToString("MMM d, yyyy")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(application.OfferDetails))
                    {
                        <div><strong>Details:</strong> @application.OfferDetails</div>
                    }
                    @if (application.OfferExpiryDate.HasValue)
                    {
                        <div><strong>Expiry:</strong> @application.OfferExpiryDate.Value.ToString("MMM d, yyyy")</div>
                    }
                </div>
            }

            @if (application.Status == "InterviewCompleted")
            {
                <form asp-controller="Company" asp-action="MakeOffer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@application.Id" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Stipend</label>
                            <input type="number" step="0.01" class="form-control" name="StipendAmount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" name="StartDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Expiry Date</label>
                            <input type="date" class="form-control" name="ExpiryDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Offer Details</label>
                            <input type="text" class="form-control" name="OfferDetails" placeholder="Optional details" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Send Offer</button>
                </form>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Status History</h5>
    </div>
    <div class="card-body">
        @if (!Model.StatusHistory.Any())
        {
            <p class="text-muted mb-0">No status history recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                        {
                            <tr>
                                <td>@item.ChangedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@item.PreviousStatus</td>
                                <td><span class="badge @GetStatusBadgeClass(item.NewStatus)">@item.NewStatus</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "InterviewScheduled" => "bg-primary",
        "InterviewCompleted" => "bg-secondary",
        "OfferMade" => "bg-dark",
        "Accepted" => "bg-success",
        "OfferDeclined" => "bg-danger",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}
