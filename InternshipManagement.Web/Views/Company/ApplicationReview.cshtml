@model InternshipManagement.Web.Models.Application.ApplicationResponse
@{
    ViewData["Title"] = "Review Application";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Review Application</h1>
        <p class="text-muted">@Model.InternshipTitle</p>
    </div>
    <a asp-controller="Company" asp-action="Applications" class="btn btn-outline-secondary">Back to Applications</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5>@Model.Student?.FullName</h5>
        <p class="text-muted mb-1">@Model.Student?.Email</p>
        <p class="text-muted">@Model.Student?.Programme at @Model.Student?.University</p>

        <dl class="row">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span></dd>
            <dt class="col-sm-3">Applied</dt>
            <dd class="col-sm-9">@Model.AppliedAt.ToString("MMM d, yyyy")</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.CoverLetter))
        {
            <h6>Cover Letter</h6>
            <p class="border rounded p-3">@Model.CoverLetter</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Student?.ResumeUrl))
        {
            <a href="@Model.Student.ResumeUrl" target="_blank" rel="noopener" class="btn btn-primary">
                <i class="fas fa-file-pdf me-1"></i> View CV / Resume
            </a>
        }
        else
        {
            <p class="text-muted">This student has not provided a CV link.</p>
        }
    </div>
</div>

@if (Model.Status == "Shortlisted" || Model.Status == "InterviewScheduled" || Model.Status == "InterviewCompleted" || Model.Status == "OfferMade" || Model.Status == "Accepted" || Model.Status == "OfferDeclined")
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Interview Management</h5>
        </div>
        <div class="card-body">
            @if (Model.InterviewDateTime.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    <strong>Interview:</strong> @Model.InterviewDateTime.Value.ToString("MMM d, yyyy h:mm tt")<br />
                    <strong>Type:</strong> @Model.InterviewType<br />
                    @if (!string.IsNullOrWhiteSpace(Model.InterviewLocationOrLink))
                    {
                        <strong>Location/Link:</strong> <a href="@Model.InterviewLocationOrLink" target="_blank" rel="noopener">@Model.InterviewLocationOrLink</a><br />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.InterviewNotes))
                    {
                        <strong>Notes:</strong> @Model.InterviewNotes
                    }
                </div>
            }

            @if (Model.Status == "Shortlisted")
            {
                <form asp-controller="Company" asp-action="ScheduleInterview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Interview Date</label>
                            <input type="datetime-local" class="form-control" name="InterviewDateTime" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Interview Type</label>
                            <input type="text" class="form-control" name="InterviewType" placeholder="Technical / HR / Final" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Location or Link</label>
                            <input type="text" class="form-control" name="InterviewLocationOrLink" placeholder="Zoom link / room number" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" name="InterviewNotes" rows="3"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Schedule Interview</button>
                </form>
            }

            @if (Model.Status == "InterviewScheduled")
            {
                <form asp-controller="Company" asp-action="MarkInterviewCompleted" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">Mark Interview Completed</button>
                </form>
            }
        </div>
    </div>
}

@if (Model.Status == "InterviewCompleted" || Model.Status == "OfferMade" || Model.Status == "Accepted" || Model.Status == "OfferDeclined")
{
    <div class="card">
        <div class="card-header bg-white">
            <h5 class="mb-0">Offer Management</h5>
        </div>
        <div class="card-body">
            @if (Model.OfferStipendAmount.HasValue || Model.OfferStartDate.HasValue || !string.IsNullOrWhiteSpace(Model.OfferDetails) || Model.OfferExpiryDate.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    @if (Model.OfferStipendAmount.HasValue)
                    {
                        <div><strong>Stipend:</strong> @Model.OfferStipendAmount.Value.ToString("C")</div>
                    }
                    @if (Model.OfferStartDate.HasValue)
                    {
                        <div><strong>Start Date:</strong> @Model.OfferStartDate.Value.ToString("MMM d, yyyy")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OfferDetails))
                    {
                        <div><strong>Details:</strong> @Model.OfferDetails</div>
                    }
                    @if (Model.OfferExpiryDate.HasValue)
                    {
                        <div><strong>Expiry:</strong> @Model.OfferExpiryDate.Value.ToString("MMM d, yyyy")</div>
                    }
                </div>
            }

            @if (Model.Status == "InterviewCompleted")
            {
                <form asp-controller="Company" asp-action="MakeOffer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Stipend</label>
                            <input type="number" step="0.01" class="form-control" name="StipendAmount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" name="StartDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Expiry Date</label>
                            <input type="date" class="form-control" name="ExpiryDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Offer Details</label>
                            <input type="text" class="form-control" name="OfferDetails" placeholder="Optional details" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Send Offer</button>
                </form>
            }
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "InterviewScheduled" => "bg-primary",
        "InterviewCompleted" => "bg-secondary",
        "OfferMade" => "bg-dark",
        "Accepted" => "bg-success",
        "OfferDeclined" => "bg-danger",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}
