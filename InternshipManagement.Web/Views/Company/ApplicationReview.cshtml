@model InternshipManagement.Web.ViewModels.ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Review Application";
    var application = Model.Application;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Review Application</h1>
        <p class="text-muted">@application.InternshipTitle</p>
    </div>
    <a asp-controller="Company" asp-action="Applications" class="btn btn-outline-secondary">Back to Applications</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5>@application.Student?.FullName</h5>
        <p class="text-muted mb-1">@application.Student?.Email</p>
        <p class="text-muted">@application.Student?.Programme at @application.Student?.University</p>

        <dl class="row">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @GetStatusBadgeClass(application.Status)">@InternshipManagement.Web.Helpers.StatusDisplay.Label(application.Status)</span></dd>
            <dt class="col-sm-3">Applied</dt>
            <dd class="col-sm-9">@application.AppliedAt.ToString("MMM d, yyyy")</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(application.CoverLetter))
        {
            <h6>Cover Letter</h6>
            <p class="border rounded p-3">@application.CoverLetter</p>
        }

        @if (application.Student?.ApplicationDocuments?.Count > 0)
        {
            <h6>Documents attached to this application</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var document in application.Student.ApplicationDocuments)
                {
                    <a asp-controller="Documents" asp-action="Download" asp-route-id="@document.Id"
                       class="btn btn-outline-primary">
                        <i class="fas fa-file-download me-1"></i> @document.FileName
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No documents were attached to this application.</p>
        }
    </div>
</div>

@if (application.Status == "Shortlisted" || application.Status == "InterviewScheduled" || application.Status == "InterviewCompleted" || application.Status == "OfferMade" || application.Status == "Accepted" || application.Status == "OfferDeclined")
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Interview Management</h5>
        </div>
        <div class="card-body">
            @if (application.InterviewDateTime.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    <strong>Interview:</strong> @application.InterviewDateTime.Value.ToString("MMM d, yyyy h:mm tt")<br />
                    <strong>Type:</strong> @application.InterviewType<br />
                    @if (!string.IsNullOrWhiteSpace(application.InterviewLocationOrLink))
                    {
                        <strong>Location/Link:</strong> <a href="@application.InterviewLocationOrLink" target="_blank" rel="noopener">@application.InterviewLocationOrLink</a><br />
                    }
                    @if (!string.IsNullOrWhiteSpace(application.InterviewNotes))
                    {
                        <strong>Notes:</strong> @application.InterviewNotes
                    }
                </div>
            }

            @if (application.Status == "Shortlisted")
            {
                <form asp-controller="Company" asp-action="ScheduleInterview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@application.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Interview Date</label>
                            <input type="datetime-local" class="form-control" name="InterviewDateTime" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Interview Type</label>
                            <input type="text" class="form-control" name="InterviewType" placeholder="Technical / HR / Final" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Location or Link</label>
                            <input type="text" class="form-control" name="InterviewLocationOrLink" placeholder="Zoom link / room number" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" name="InterviewNotes" rows="3"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Schedule Interview</button>
                </form>
            }

            @if (application.Status == "InterviewScheduled")
            {
                <div class="d-flex flex-wrap gap-2">
                    <form asp-controller="Company" asp-action="MarkInterviewCompleted" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@application.Id" />
                        <button type="submit" class="btn btn-success">Mark Interview Completed</button>
                    </form>
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#reschedule-interview">
                        <i class="fas fa-calendar-alt me-1"></i> Reschedule
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#cancel-interview">
                        <i class="fas fa-times me-1"></i> Cancel interview
                    </button>
                </div>

                <div class="collapse mt-3" id="reschedule-interview">
                    <form asp-controller="CompanyInterviews" asp-action="Reschedule" asp-route-id="@application.Id" method="post" class="border rounded p-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">New date and time</label>
                                <input type="datetime-local" class="form-control" name="InterviewDateTime" required
                                       value="@(application.InterviewDateTime.HasValue ? application.InterviewDateTime.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Interview type</label>
                                <input type="text" class="form-control" name="InterviewType" required value="@application.InterviewType" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Location or link</label>
                                <input type="text" class="form-control" name="InterviewLocationOrLink" value="@application.InterviewLocationOrLink" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes for the candidate</label>
                                <textarea class="form-control" name="InterviewNotes" rows="2">@application.InterviewNotes</textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Save new time</button>
                    </form>
                </div>

                <div class="collapse mt-3" id="cancel-interview">
                    <form asp-controller="CompanyInterviews" asp-action="Cancel" asp-route-id="@application.Id" method="post" class="border rounded p-3"
                          onsubmit="return confirm('Cancel this interview? The candidate will be told and goes back to the shortlist.');">
                        <label class="form-label">Reason (shown to the candidate, optional)</label>
                        <textarea class="form-control" name="reason" rows="2" maxlength="500"></textarea>
                        <button type="submit" class="btn btn-danger mt-3">Cancel interview</button>
                    </form>
                </div>
            }
        </div>
    </div>
}

@if (application.Status == "InterviewCompleted" || application.Status == "OfferMade" || application.Status == "OfferExpired" || application.Status == "Accepted" || application.Status == "OfferDeclined")
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Offer Management</h5>
        </div>
        <div class="card-body">
            @if (application.OfferStipendAmount.HasValue || application.OfferStartDate.HasValue || !string.IsNullOrWhiteSpace(application.OfferDetails) || application.OfferExpiryDate.HasValue)
            {
                <div class="alert alert-light border mb-3">
                    @if (application.OfferStipendAmount.HasValue)
                    {
                        <div><strong>Stipend:</strong> @application.OfferStipendAmount.Value.ToString("C")</div>
                    }
                    @if (application.OfferStartDate.HasValue)
                    {
                        <div><strong>Start Date:</strong> @application.OfferStartDate.Value.ToString("MMM d, yyyy")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(application.OfferDetails))
                    {
                        <div><strong>Details:</strong> @application.OfferDetails</div>
                    }
                    @if (application.OfferExpiryDate.HasValue)
                    {
                        <div><strong>Expiry:</strong> @application.OfferExpiryDate.Value.ToString("MMM d, yyyy")</div>
                    }
                </div>
            }

            @if (application.Status == "OfferMade")
            {
                <div class="alert alert-info mb-0"><i class="fas fa-hourglass-half me-1"></i> Offer sent. Waiting for the student to accept or decline@(application.OfferExpiryDate.HasValue ? $" before {application.OfferExpiryDate.Value:MMM d, yyyy}" : ""). <a asp-controller="OfferLetters" asp-action="Letter" asp-route-id="@application.Id">View the offer letter or attach a contract</a></div>
            }
            else if (application.Status == "Accepted")
            {
                <div class="alert alert-success mb-0">
                    <i class="fas fa-check-circle me-1"></i> <strong>Offer accepted.</strong>
                    @if (application.OfferStartDate.HasValue && application.OfferStartDate.Value.Date > DateTime.UtcNow.Date)
                    {
                        <text> The placement starts on @application.OfferStartDate.Value.ToString("MMM d, yyyy") and becomes active automatically.</text>
                    }
                    else
                    {
                        <text> The placement is active.</text>
                    }
                    <div class="mt-2"><a asp-controller="Company" asp-action="Placements" class="btn btn-sm btn-success">Open placements</a></div>
                    <div class="small mt-2">If the student is finishing another placement first, this one is created when that placement ends.</div>
                </div>
            }
            else if (application.Status == "OfferDeclined")
            {
                <div class="alert alert-secondary mb-0">The student declined this offer.</div>
            }
            else if (application.Status == "OfferExpired")
            {
                <div class="alert alert-warning"><i class="fas fa-clock me-1"></i> This offer expired before the student replied. You can send it again with a new expiry date.</div>
            }

            @if (application.Status == "InterviewCompleted" || application.Status == "OfferExpired")
            {
                <form asp-controller="Company" asp-action="MakeOffer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@application.Id" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Stipend</label>
                            <input type="number" step="0.01" class="form-control" name="StipendAmount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" name="StartDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Expiry Date</label>
                            <input type="date" class="form-control" name="ExpiryDate" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Offer Details</label>
                            <input type="text" class="form-control" name="OfferDetails" placeholder="Optional details" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">@(application.Status == "OfferExpired" ? "Send Offer Again" : "Send Offer")</button>
                </form>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Status History</h5>
    </div>
    <div class="card-body">
        @if (!Model.StatusHistory.Any())
        {
            <p class="text-muted mb-0">No status history recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                        {
                            <tr>
                                <td>@item.ChangedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@item.PreviousStatus</td>
                                <td><span class="badge @GetStatusBadgeClass(item.NewStatus)">@InternshipManagement.Web.Helpers.StatusDisplay.Label(item.NewStatus)</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (application.Status == "Applied" || application.Status == "UnderReview")
{
    <div class="d-flex justify-content-end mt-4">
        <form asp-controller="Company" asp-action="ShortlistApplication" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@application.Id" />
            <input type="hidden" name="returnToReview" value="true" />
            <button type="submit" class="btn btn-success" onclick="return confirm('Shortlist this applicant?')">
                <i class="fas fa-star me-1"></i> Shortlist applicant
            </button>
        </form>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => InternshipManagement.Web.Helpers.StatusDisplay.Badge(status);
}
