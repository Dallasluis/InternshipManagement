@model List<InternshipManagement.Web.Models.Application.ApplicationResponse>
@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">My Applications</h1>
        <p class="text-muted">Track all your internship applications in one place</p>
    </div>
    <a asp-controller="Internships" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-search me-1"></i> Find More Internships
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
        <h5>No Applications Yet</h5>
        <p class="text-muted">You haven't applied to any internships yet.</p>
        <a asp-controller="Internships" asp-action="Index" class="btn btn-primary">
            Browse Internships
        </a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Internship</th>
                            <th>Company</th>
                            <th>Applied On</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.OrderByDescending(a => a.AppliedAt))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@app.InternshipId" class="text-decoration-none">
                                        @app.InternshipTitle
                                    </a>
                                </td>
                                <td>@app.CompanyName</td>
                                <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(app.Status)">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Student" asp-action="ApplicationDetails" asp-route-id="@app.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (app.Status != "Rejected" && app.Status != "Withdrawn")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" onclick="withdrawApplication(@app.Id)">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script>
        function withdrawApplication(id) {
            if (confirm('Are you sure you want to withdraw this application?')) {
                fetch(`/api/applications/${id}/withdraw`, { method: 'POST' })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        }
                    })
                    .catch(error => {
                        alert('Failed to withdraw application. Please try again.');
                    });
            }
        }
    </script>
}