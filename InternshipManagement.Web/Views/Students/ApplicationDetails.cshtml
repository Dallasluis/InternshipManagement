@model InternshipManagement.Web.Models.Application.ApplicationResponse
@{
    ViewData["Title"] = "Application Details";
}

<div class="mb-3">
    <a asp-controller="Student" asp-action="Applications" class="text-muted">
        <i class="fas fa-arrow-left me-1"></i> Back to My Applications
    </a>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.InternshipTitle</h5>
        <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <h6>Company</h6>
                <p>@Model.CompanyName</p>

                <h6>Applied On</h6>
                <p>@Model.AppliedAt.ToString("MMMM dd, yyyy")</p>

                @if (!string.IsNullOrEmpty(Model.CoverLetter))
                {
                    <h6>Cover Letter</h6>
                    <div class="border rounded p-3 bg-light">
                        <p style="white-space: pre-line;">@Model.CoverLetter</p>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6>Application Status</h6>
                        <p>
                            <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                        </p>
                        <hr />
                        <h6>Timeline</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Applied: @Model.AppliedAt.ToString("MMM dd, yyyy")
                            </li>
                            @if (Model.StatusUpdatedAt.HasValue && Model.StatusUpdatedAt != Model.AppliedAt)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-clock text-warning me-2"></i>
                                    Status Updated: @Model.StatusUpdatedAt.Value.ToString("MMM dd, yyyy")
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Applied" => "bg-info",
        "UnderReview" => "bg-warning",
        "Shortlisted" => "bg-success",
        "Rejected" => "bg-danger",
        "Withdrawn" => "bg-secondary",
        "WithdrawnAcceptedElsewhere" => "bg-secondary",
        _ => "bg-secondary"
    };
}